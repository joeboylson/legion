#!/usr/bin/env python3
"""legion-channeld — relays messages between squads over a plain TCP socket.

    legion-channeld --root <path to .legion>

Started in the background by `legion channel open` and/or `legion channel
subscribe`; stopped by `legion channel close`. Not meant to be run by hand.

Two roles, run at once, both driven by files in .legion/channel/:
  listener   if channel/config.json has a port, accept connections there.
             An optional key in config.json must match a connecting peer's.
  subscriber for every entry in channel/subscriptions.json, dial out and
             keep the connection open, reconnecting on drop.

Every connection speaks line-delimited JSON, once a "hello" (team name +
this squad's operators) has gone each way:

  {"type": "hello", "team": "myapp", "key": "...", "operators": [...]}
  {"type": "relay", "to": "myapp", "from": "otherapp", "operator": "commander", "text": "..."}

A relay addressed to this squad is dropped into .legion/messages/ the same
way `legion message send` does, by running that same command — so the
existing Stop/PostToolUse hooks pick it up exactly like an internal
message, with no changes to those hooks. A relay addressed to another
connected team is forwarded to that connection, so the listener side also
acts as a hub between whoever has subscribed to it.

Outbound sends come from channel/outbox/<name>.json ({"to", "text",
"operator"}), written by `legion channel send` and picked up here, and live
peer state (who's connected, their operators) is written to
channel/peers/<team>.json for `legion channel peers` to read.

No packages beyond Python 3.
"""
import asyncio
import json
import os
import re
import shlex
import subprocess
import sys
import time

POLL_SECONDS = 1
RECONNECT_SECONDS = 5


def die(msg):
    sys.stderr.write("legion-channeld: %s\n" % msg)
    sys.exit(1)


def parse_args(argv):
    root = None
    i = 0
    while i < len(argv):
        if argv[i] == "--root" and i + 1 < len(argv):
            root, i = argv[i + 1], i + 2
        else:
            die("unknown argument %r (want --root <path to .legion>)" % argv[i])
    if not root:
        die("--root <path to .legion> is required")
    return root


ROOT = os.path.abspath(os.path.expanduser(parse_args(sys.argv[1:])))
PROJECT = os.path.dirname(ROOT)
CHANNEL = os.path.join(ROOT, "channel")
CONFIG = os.path.join(CHANNEL, "config.json")
SUBS = os.path.join(CHANNEL, "subscriptions.json")
PEERS = os.path.join(CHANNEL, "peers")
OUTBOX = os.path.join(CHANNEL, "outbox")
LOG = os.path.join(CHANNEL, "channel.log")
ACTIVITY = os.path.join(ROOT, "activity.log")
FEED = os.path.join(CHANNEL, "feed.jsonl")
QUESTIONS = os.path.join(ROOT, "questions")
# Other squads' open questions, one file per team, as they last sent them.
REMOTE_QUESTIONS = os.path.join(CHANNEL, "remote-questions")
QUESTIONS_POLL_SECONDS = 3
# Sent again this often even when nothing changed, so a squad that
# connects later (or restarts its dash) gets them.
QUESTIONS_RESEND_SECONDS = 30
for d in (CHANNEL, PEERS, OUTBOX):
    os.makedirs(d, exist_ok=True)


def log(msg):
    with open(LOG, "a") as f:
        f.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), msg))


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return default


def squad_name():
    return read_json(os.path.join(ROOT, "legion.json"), {}).get("squad", "")


SQUAD = squad_name()
if not SQUAD:
    die(".legion/legion.json has no squad name")


def operators():
    out = []
    d = os.path.join(ROOT, "operators")
    if not os.path.isdir(d):
        return out
    for name in sorted(os.listdir(d)):
        path = os.path.join(d, name)
        if name == "commander" or not os.path.isdir(path):
            continue
        about = ""
        defn = os.path.join(path, "definition.md")
        if os.path.isfile(defn):
            with open(defn) as f:
                for line in f:
                    line = line.strip().lstrip("#").strip()
                    if line:
                        about = line
                        break
        out.append({"name": name, "about": about})
    return out


def hello(key=None):
    msg = {"type": "hello", "team": SQUAD, "operators": operators()}
    if key:
        msg["key"] = key
    return msg


def peer_path(team):
    return os.path.join(PEERS, re.sub(r"[^a-zA-Z0-9_-]", "_", team) + ".json")


def write_peer(team, **fields):
    info = read_json(peer_path(team), {"team": team})
    info.update(fields)
    with open(peer_path(team), "w") as f:
        json.dump(info, f, indent=2)


# team -> asyncio.StreamWriter, for whichever side (listener or subscriber)
# currently holds an open connection to that team.
CONNECTIONS = {}
# team -> the connected team that says it can reach it. Each side tells the
# others which teams it's connected to (a "peers" line), so a subscriber can
# send to another subscriber of the same channel through the host.
VIA = {}
# How long an outbox message waits for its team to become reachable before
# it's moved to outbox/failed/.
UNDELIVERABLE_SECONDS = 600
# Teams this side subscribed to (dialled out to): the hosts of channels.
OUTBOUND = set()
# Teams that have told us who they're connected to (a "peers" line).
SAYS_PEERS = set()


async def broadcast_peers():
    """Tells every connection which teams this side is connected to."""
    teams = sorted(CONNECTIONS)
    for writer in list(CONNECTIONS.values()):
        try:
            await send_line(writer, {"type": "peers", "teams": teams})
        except OSError:
            pass


def learn_peers(hub, teams):
    """Records the teams a connected team can reach, replacing what it said before."""
    for team in [t for t, h in VIA.items() if h == hub and t not in teams]:
        del VIA[team]
        if team not in CONNECTIONS:
            write_peer(team, connected=False, via=None, last_seen=time.time())
    for team in teams:
        if team in (SQUAD, hub) or team in CONNECTIONS:
            continue
        VIA[team] = hub
        write_peer(team, connected=True, via=hub, last_seen=time.time())


def route(team):
    """The writer that reaches a team: directly, or through a team that can reach it."""
    if team in CONNECTIONS:
        return CONNECTIONS[team]
    hub = VIA.get(team)
    if hub in CONNECTIONS:
        return CONNECTIONS[hub]
    # A host running an older Legion never says who it's connected to, but
    # it still passes relays on, so hand it to the host.
    for hub in sorted(OUTBOUND):
        if hub in CONNECTIONS and hub not in SAYS_PEERS:
            VIA[team] = hub
            return CONNECTIONS[hub]
    return None


def deliver_locally(operator, text, sender_team):
    """Drops a message into .legion/messages/ the same way `legion message
    send` does, by actually running it — so delivery stays the one place
    that logic lives, and the hooks that already watch for new mail pick
    this up unchanged."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("LEGION_")}
    env["LEGION_MESSAGE_AS"] = "external:%s" % sender_team
    script = "cd %s && . .legion/bin/activate >/dev/null && legion message send %s -" % (
        shlex.quote(PROJECT), shlex.quote(operator))
    try:
        p = subprocess.run(["bash", "-c", script], input=text, capture_output=True,
                            text=True, env=env, timeout=30)
        if p.returncode != 0:
            log("delivery to %s failed: %s" % (operator, (p.stdout + p.stderr).strip()))
        else:
            log("delivered to %s from %s: %s" % (operator, sender_team, text))
    except Exception as e:
        log("delivery to %s raised: %s" % (operator, e))


async def send_line(writer, obj):
    writer.write((json.dumps(obj) + "\n").encode())
    await writer.drain()


def feed_append(team, event):
    with open(FEED, "a") as f:
        f.write(json.dumps({"team": team, **event}) + "\n")


def open_questions():
    """This squad's open questions, as {"meta": {...}, "body": "..."}."""
    out = []
    try:
        names = sorted(n for n in os.listdir(QUESTIONS) if re.match(r"Q-\d+\.md$", n))
    except FileNotFoundError:
        return out
    for n in names:
        try:
            with open(os.path.join(QUESTIONS, n)) as f:
                text = f.read()
        except OSError:
            continue
        m = re.match(r"---\n(.*?)\n---\n(.*)", text, re.S)
        if not m:
            continue
        meta = {}
        for line in m.group(1).split("\n"):
            k, sep, v = line.partition(": ")
            if sep:
                meta[k] = v
        if meta.get("status") == "open":
            out.append({"meta": meta, "body": m.group(2)})
    return out


def answer_locally(qid, answer, sender_team):
    """Answers one of this squad's questions with Legion's own human-role
    answer tool, as if the human had answered here."""
    mcp = os.path.join(os.path.dirname(os.path.realpath(__file__)), "legion-mcp")
    req = {"jsonrpc": "2.0", "id": 1, "method": "tools/call",
           "params": {"name": "answer", "arguments": {"id": qid, "answer": answer}}}
    try:
        p = subprocess.run([sys.executable, mcp, "--role", "human", "--project", PROJECT],
                           input=json.dumps(req) + "\n", capture_output=True, text=True, timeout=60)
        reply = json.loads(p.stdout.strip().split("\n")[0])
        text = "".join(c.get("text", "") for c in reply.get("result", {}).get("content", [])) \
            or reply.get("error", {}).get("message", "")
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError) as e:
        text = "couldn't run the answer tool: %s" % e
    log("answer to %s from %s: %s (%s)" % (qid, sender_team, answer, text))


async def handle_answer(msg, sender_team):
    to = msg.get("to", "")
    if to == SQUAD:
        answer_locally(msg.get("id", ""), msg.get("answer", ""), msg.get("from") or sender_team)
    elif to in CONNECTIONS:
        # One hop at most, like relays.
        await send_line(CONNECTIONS[to], msg)
        log("forwarded an answer to %s %s from %s" % (to, msg.get("id"), sender_team))
    else:
        log("answer for unknown/disconnected team %r dropped (from %s)" % (to, sender_team))


# (team, operator) -> when the sender was last told no one is listening.
UNHEARD_TOLD = {}
UNHEARD_GAP_SECONDS = 600
UNHEARD_PREFIX = "NOT HEARD"


async def tell_if_unheard(operator, text, sender_team):
    """A message is in the inbox, but with no session running for that
    position here nobody will read it. Say so to the team that sent it,
    once every 10 minutes at most, and never in answer to one of these (two
    squads with no one listening would pass them back and forth)."""
    if text.startswith(UNHEARD_PREFIX) or operator in positions_running():
        return
    now = time.time()
    if now - UNHEARD_TOLD.get((sender_team, operator), 0) < UNHEARD_GAP_SECONDS:
        return
    writer = route(sender_team)
    if writer is None:
        return
    UNHEARD_TOLD[(sender_team, operator)] = now
    note = ("%s from %s: your message to %s is in its inbox, but %s has no Claude session running on %s, "
            "so no one will read it until one starts. The human there can start it with: legion commander"
            % (UNHEARD_PREFIX, SQUAD, operator, operator, SQUAD)) if operator == "commander" else (
            "%s from %s: your message to %s is in its inbox, but %s has no Claude session running on %s, "
            "so no one will read it until it starts again." % (UNHEARD_PREFIX, SQUAD, operator, operator, SQUAD))
    try:
        await send_line(writer, {"type": "relay", "to": sender_team, "from": SQUAD,
                                 "operator": "commander", "text": note})
        log("told %s that %s isn't running: %s" % (sender_team, operator, note))
    except OSError:
        pass


async def handle_relay(msg, sender_team, writer=None):
    to = msg.get("to", "")
    operator = msg.get("operator") or "commander"
    text = msg.get("text", "")
    if to == SQUAD:
        deliver_locally(operator, text, sender_team)
        await tell_if_unheard(operator, text, sender_team)
    elif to in CONNECTIONS:
        # Only to a direct connection, never on through VIA: one hop at
        # most, so relays can't loop.
        await send_line(CONNECTIONS[to], msg)
        log("forwarded relay from %s to %s" % (sender_team, to))
    else:
        log("relay to unknown/disconnected team %r dropped (from %s)" % (to, sender_team))
        # Tell whoever handed it over, so it isn't lost without a word.
        if writer is not None:
            try:
                await send_line(writer, {"type": "undeliverable", "to": to, "text": text})
            except OSError:
                pass


async def handle_connection(reader, writer, key, initiated_by_us, team_hint=None):
    """Reads hello/relay lines from one connection until it closes. The
    initiator has already sent its own hello before this is called; the
    acceptor sends its hello back once the peer's has been checked."""
    peer_team = team_hint
    replied = False
    try:
        while True:
            line = await reader.readline()
            if not line:
                break
            try:
                m = json.loads(line.decode())
            except ValueError:
                continue
            mtype = m.get("type")
            if mtype == "hello":
                if not initiated_by_us and key and m.get("key") != key:
                    await send_line(writer, {"type": "error", "message": "invalid key"})
                    log("rejected connection (bad key), claimed team %r" % m.get("team"))
                    break
                peer_team = m.get("team") or peer_team or "?"
                CONNECTIONS[peer_team] = writer
                VIA.pop(peer_team, None)
                if initiated_by_us:
                    OUTBOUND.add(peer_team)
                write_peer(peer_team, operators=m.get("operators", []), connected=True,
                           direction="outbound" if initiated_by_us else "inbound",
                           via=None, last_seen=time.time())
                if not initiated_by_us and not replied:
                    await send_line(writer, hello())
                    replied = True
                log("connected: %s" % peer_team)
                await broadcast_peers()
            elif mtype == "peers":
                SAYS_PEERS.add(peer_team)
                learn_peers(peer_team, m.get("teams", []))
            elif mtype == "undeliverable":
                log("%s couldn't pass on the message to %s: %s" % (peer_team, m.get("to"), m.get("text", "")))
            elif mtype == "relay":
                # The team that wrote it, not the host that passed it on.
                await handle_relay(m, m.get("from") or peer_team or "?", writer)
            elif mtype == "questions":
                team = m.get("team") or peer_team or "?"
                if team != SQUAD:
                    os.makedirs(REMOTE_QUESTIONS, exist_ok=True)
                    safe = re.sub(r"[^a-zA-Z0-9_-]", "_", team)
                    tmp = os.path.join(REMOTE_QUESTIONS, ".%s.tmp" % safe)
                    with open(tmp, "w") as f:
                        json.dump({"team": team, "received_at": time.time(),
                                   "questions": m.get("questions", [])}, f)
                    os.replace(tmp, os.path.join(REMOTE_QUESTIONS, safe + ".json"))
                # Pass it on once, like activity.
                if not m.get("relayed"):
                    for other_team, other in list(CONNECTIONS.items()):
                        if other is writer or other_team == team:
                            continue
                        try:
                            await send_line(other, dict(m, relayed=True))
                        except OSError:
                            pass
            elif mtype == "answer":
                await handle_answer(m, peer_team or "?")
            elif mtype == "activity":
                feed_append(m.get("team", peer_team or "?"), m.get("event", {}))
                # Pass it on to the other teams connected here, so every
                # subscriber of a channel sees every other one's activity.
                # Only once: a passed-on line isn't passed on again.
                if not m.get("relayed"):
                    for team, other in list(CONNECTIONS.items()):
                        if other is writer or team == m.get("team"):
                            continue
                        try:
                            await send_line(other, dict(m, relayed=True))
                        except OSError:
                            pass
            elif mtype == "error":
                log("peer error from %s: %s" % (peer_team, m.get("message")))
                break
    except (ConnectionResetError, asyncio.IncompleteReadError, OSError):
        pass
    finally:
        if peer_team and CONNECTIONS.get(peer_team) is writer:
            del CONNECTIONS[peer_team]
            OUTBOUND.discard(peer_team)
            SAYS_PEERS.discard(peer_team)
            write_peer(peer_team, connected=False, last_seen=time.time())
            learn_peers(peer_team, [])
            log("disconnected: %s" % peer_team)
            await broadcast_peers()
        writer.close()


async def serve():
    config = read_json(CONFIG, None)
    if not config or not config.get("port"):
        return
    key = config.get("key")

    async def on_client(reader, writer):
        await handle_connection(reader, writer, key, initiated_by_us=False)

    server = await asyncio.start_server(on_client, "0.0.0.0", int(config["port"]))
    log("listening on 0.0.0.0:%s%s" % (config["port"], " (key required)" if key else ""))
    async with server:
        await server.serve_forever()


async def maintain_subscription(sub):
    host, port, team, key = sub["host"], int(sub["port"]), sub["team"], sub.get("key")
    while True:
        try:
            reader, writer = await asyncio.open_connection(host, port)
            await send_line(writer, hello(key))
            log("subscribed to %s at %s:%s" % (team, host, port))
            await handle_connection(reader, writer, key, initiated_by_us=True, team_hint=team)
        except (ConnectionRefusedError, OSError, ConnectionResetError) as e:
            log("subscribe to %s (%s:%s): %s — retrying in %ss" % (team, host, port, e, RECONNECT_SECONDS))
        await asyncio.sleep(RECONNECT_SECONDS)


async def watch_subscriptions():
    # Keyed by (host, port, team) -> (task, the sub dict it was started with),
    # so editing a subscription's key (or removing it) takes effect on a
    # daemon that's already running, not just on the next restart.
    active = {}
    while True:
        subs = read_json(SUBS, [])
        seen = set()
        for sub in subs:
            key_id = (sub["host"], sub["port"], sub["team"])
            seen.add(key_id)
            prev = active.get(key_id)
            if prev is None or prev[1] != sub:
                if prev is not None:
                    prev[0].cancel()
                active[key_id] = (asyncio.ensure_future(maintain_subscription(sub)), sub)
        for key_id in list(active):
            if key_id not in seen:
                active.pop(key_id)[0].cancel()
        await asyncio.sleep(POLL_SECONDS)


async def watch_outbox():
    while True:
        try:
            names = sorted(os.listdir(OUTBOX))
        except FileNotFoundError:
            names = []
        for name in names:
            if not name.endswith(".json"):
                continue
            path = os.path.join(OUTBOX, name)
            msg = read_json(path, None)
            if msg is not None:
                to = msg.get("to", "")
                if msg.get("kind") == "answer":
                    # An answer to another squad's question, written by legion dash.
                    relay = {"type": "answer", "to": to, "from": SQUAD,
                             "id": msg.get("id", ""), "answer": msg.get("answer", "")}
                else:
                    relay = {"type": "relay", "to": to, "from": SQUAD,
                             "operator": msg.get("operator") or "commander", "text": msg.get("text", "")}
                writer = route(to)
                if writer is None:
                    # Not reachable yet (still connecting, say): keep it and
                    # try again, and only give up after a while, keeping it.
                    try:
                        age = time.time() - os.path.getmtime(path)
                    except FileNotFoundError:
                        continue
                    if age < UNDELIVERABLE_SECONDS:
                        continue
                    os.makedirs(os.path.join(OUTBOX, "failed"), exist_ok=True)
                    os.replace(path, os.path.join(OUTBOX, "failed", name))
                    log("cannot send to %s: not reachable for %d minutes; kept in outbox/failed/%s"
                        % (to, UNDELIVERABLE_SECONDS // 60, name))
                    continue
                await send_line(writer, relay)
                log("sent to %s%s: %s" % (to, "" if to in CONNECTIONS else " via %s" % VIA.get(to),
                                          msg.get("text") or "answer %s: %s" % (msg.get("id"), msg.get("answer"))))
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
        await asyncio.sleep(POLL_SECONDS)


async def watch_activity():
    """Tails this squad's own .legion/activity.log (every tool call any
    position makes) from wherever it is when the daemon starts, mirrors
    each new line into the local merged feed, and broadcasts it to every
    connected peer so their feed picks it up too — the whole point being
    that either side of a channel ends up with one combined view of both
    squads' activity, not just its own."""
    pos = os.path.getsize(ACTIVITY) if os.path.isfile(ACTIVITY) else 0
    while True:
        if os.path.isfile(ACTIVITY):
            with open(ACTIVITY) as f:
                f.seek(pos)
                lines = f.readlines()
                pos = f.tell()
            for line in lines:
                line = line.strip()
                if not line:
                    continue
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                feed_append(SQUAD, event)
                for writer in list(CONNECTIONS.values()):
                    try:
                        await send_line(writer, {"type": "activity", "team": SQUAD, "event": event})
                    except OSError:
                        pass
        await asyncio.sleep(POLL_SECONDS)


MESSAGES = os.path.join(ROOT, "messages")
WAKE_CHECK_SECONDS = 30
# How long a window must sit unchanged, with mail unread that long, before
# it counts as idle. A session mid-turn keeps redrawing its spinner, and a
# person typing changes it too.
WAKE_IDLE_SECONDS = 120
# Don't wake the same window again sooner than this, in case it's stuck on
# something the wake line can't fix.
WAKE_GAP_SECONDS = 600
WAKE_TEXT = ("You have new messages: run legion message read and act on them, then start "
             "legion message wait in the background again.")
SHELLS = {"bash", "zsh", "sh", "fish", "dash"}


def tmux(*args):
    p = subprocess.run(["tmux"] + list(args), capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else None


def claude_pids():
    """{pid: parent pid} for every process, and the set of those that are claude."""
    try:
        out = subprocess.run(["ps", "-axo", "pid=,ppid=,args="], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}, set()
    parent, claude = {}, set()
    for line in out.splitlines():
        f = line.split()
        if len(f) < 3:
            continue
        parent[f[0]] = f[1]
        prog = os.path.basename(f[2])
        if prog == "claude" or (prog.startswith("node") and len(f) > 3 and os.path.basename(f[3]) == "claude"):
            claude.add(f[0])
    return parent, claude


def session_running(pane_pid, dead, procs):
    """Whether a Claude session runs in a pane: it hasn't exited and a claude
    process is the pane's own or under it. The same check as
    pane_session_running in bin/legion: a session that ended can leave its
    pane open."""
    if dead == "1" or not pane_pid:
        return False
    parent, claude = procs
    for pid in claude:
        seen = set()
        while pid and pid not in seen:
            if pid == pane_pid:
                return True
            seen.add(pid)
            pid = parent.get(pid)
    return False


def positions_running():
    """This squad's positions whose Claude session is running."""
    out = tmux("list-panes", "-a", "-F", "#{@legion_squad}\t#{@legion_addr}\t#{pane_pid}\t#{pane_dead}")
    procs = claude_pids()
    running = set()
    for line in (out or "").splitlines():
        squad, addr, pid, dead = (line.split("\t") + ["", "", "", ""])[:4]
        if squad == SQUAD and addr.startswith(SQUAD + "-") and session_running(pid, dead, procs):
            running.add(addr[len(SQUAD) + 1:])
    return running


def waiting(position):
    try:
        with open(os.path.join(MESSAGES, position, "waiting.pid")) as f:
            os.kill(int(f.read().strip()), 0)
        return True
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return False


def oldest_unread(position):
    d = os.path.join(MESSAGES, position, "new")
    try:
        times = [os.path.getmtime(os.path.join(d, n)) for n in os.listdir(d)]
    except FileNotFoundError:
        return None
    return min(times) if times else None


async def watch_deaf():
    """Wakes a position that has stopped listening. Its message wait can
    stop while it sits idle (someone presses Esc in its window, say), and
    then nothing tells it about new mail: the hooks only run during a turn.
    For a squad left running to answer other squads over the channel, that
    means silence nobody notices. Once the window has sat unchanged with
    mail unread for a while, clear any half-typed text and type a line
    telling it to read its messages, which starts a turn."""
    screens = {}  # pane id -> (screen text, time it last changed)
    woken = {}    # pane id -> time last woken
    while True:
        await asyncio.sleep(WAKE_CHECK_SECONDS)
        out = tmux("list-panes", "-a", "-F",
                   "#{pane_id}\t#{@legion_squad}\t#{@legion_addr}\t#{pane_current_command}\t#{pane_pid}\t#{pane_dead}")
        procs = claude_pids()
        panes = {}
        for line in (out or "").splitlines():
            pane, squad, addr, command, pid, dead = (line.split("\t") + [""] * 6)[:6]
            # A window left open by a session that ended has no one to wake.
            # The watcher in bin/legion finds it and closes it.
            if squad == SQUAD and addr.startswith(SQUAD + "-") and session_running(pid, dead, procs):
                panes[addr[len(SQUAD) + 1:]] = (pane, command)
        now = time.time()
        for position, (pane, command) in panes.items():
            screen = tmux("capture-pane", "-p", "-t", pane)
            if screen is None:
                continue
            if screens.get(pane, (None,))[0] != screen:
                screens[pane] = (screen, now)
            idle_since = screens[pane][1]
            oldest = oldest_unread(position)
            if (oldest is None or waiting(position) or command in SHELLS
                    or now - oldest < WAKE_IDLE_SECONDS or now - idle_since < WAKE_IDLE_SECONDS
                    or now - woken.get(pane, 0) < WAKE_GAP_SECONDS):
                continue
            # A permission question is waiting for a person, and keys typed
            # into it could answer it.
            if re.search(r"Do you want to|\b1\. Yes\b", screen):
                continue
            # Clear half-typed text the way pane_clear_input in bin/legion
            # does: Ctrl-U and Backspace, never Ctrl-C, which quits Claude
            # Code when two land close together.
            for _ in range(4):
                tmux("send-keys", "-t", pane, "C-u")
                tmux("send-keys", "-t", pane, "BSpace")
            tmux("send-keys", "-t", pane, "C-u")
            await asyncio.sleep(0.5)
            tmux("send-keys", "-t", pane, "-l", WAKE_TEXT)
            tmux("send-keys", "-t", pane, "Enter")
            woken[pane] = now
            log("woke %s: unread messages and no message wait running" % position)
            with open(os.path.join(ROOT, "local", "sessions.log"), "a") as f:
                f.write("%s %s: woken by the channel (unread messages, no message wait)\n"
                        % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), position))
        for pane in list(screens):
            if pane not in {p for p, _ in panes.values()}:
                del screens[pane]


async def watch_questions():
    """Sends this squad's open questions to every connected team whenever
    they change, and every so often anyway."""
    last, sent_at, teams = None, 0, set()
    while True:
        qs = open_questions()
        now = time.time()
        if qs != last or set(CONNECTIONS) != teams or now - sent_at > QUESTIONS_RESEND_SECONDS:
            for writer in list(CONNECTIONS.values()):
                try:
                    await send_line(writer, {"type": "questions", "team": SQUAD, "questions": qs})
                except OSError:
                    pass
            last, sent_at, teams = qs, now, set(CONNECTIONS)
        await asyncio.sleep(QUESTIONS_POLL_SECONDS)


async def main():
    log("starting for squad '%s' (root=%s)" % (SQUAD, ROOT))
    await asyncio.gather(serve(), watch_subscriptions(), watch_outbox(), watch_activity(), watch_deaf(),
                         watch_questions())


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass

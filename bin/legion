#!/usr/bin/env bash
# legion — Claude Code squad over tmux, run on mission command. One squad
# per project. Commander sets direction/goals and arbitrates; operators own
# the how and coordinate directly with each other for their expertise.
#
# Nothing but `init` works until a project has been activated:
#   legion init [squad-name]         # once, creates ./.legion (commit it — see log.md)
#   source .legion/bin/activate      # per shell — scopes roster/session-id, gates commands
#   legion squad "ship the thing"
#   deactivate                       # defined by the sourced script
set -euo pipefail

require_active() {
  if [ -z "${LEGION_ROOT:-}" ]; then
    echo "not inside an activated Legion shell — run: source .legion/bin/activate" >&2
    echo "(no ./.legion yet? run: legion init)" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
legion — Claude Code squad over tmux, run on mission command, scoped per project

  legion init [squad-name]      create ./.legion (roster/missions dirs + activate script)

Once activated (source .legion/bin/activate):
  legion commander [mission...]     start/reattach the fixed commander session
  legion deploy                     roll call: start commander + every operator in .legion/operators/, no mission
  legion deploy <operator> [mission...]   deploy an operator reporting only to commander
  legion squad [mission...]         deploy commander + planner + builder + reviewer
  legion roster                     show roster/*.md (who has checked in)
  legion list                       show this squad's tmux windows
  legion check [operator...]        check operator.json files against the schema
  legion grid                       open one tmux window tiling every position
  legion mission start <n>          give mission <n> its own git worktree and branch
  legion mission finish <n>         fast-forward the base branch to it and remove the worktree
  legion attach <operator>           jump to an operator's tmux window
  legion capture <operator> [lines]  read an operator's tmux pane without attaching
  legion scale <operator>           show how many copies of a scalable operator are running
  legion scale up <operator> [mission...]   start its next free copy (<operator>-2, …)
  legion stand-down                 stop every position in this squad
  legion stand-down <operator>       stop one position and close its tile
  deactivate                        leave the shell (from the sourced script)
EOF
}

# Reads a plain-text file (one entry per line, # comments, blank lines
# skipped) and echoes it back as repeated "<flag> <value>" pairs.
flag_from_list() {
  local flag="$1" file="$2" out="" line
  [ -f "$file" ] || { echo ""; return 0; }
  while IFS= read -r line; do
    line="${line%%#*}"
    line="$(echo "$line" | xargs)"
    [ -n "$line" ] && out="$out $flag $(printf '%q' "$line")"
  done < "$file"
  echo "$out"
}

# Config is per operator, not per squad: each operator gets its own optional
# allowed-tools/disallowed-tools/settings.json/mcp.json under
# $LEGION_OPERATORS/<operator>/ — e.g. a planner can be denied Edit on the
# actual code while commander and builder keep full access. AO (directory
# access) and the layered/isolated split stay squad-wide; everything else is
# per operator.
# IMPORTANT: this must always be the LAST thing appended to a claude_cmd —
# --add-dir/--allowedTools/--disallowedTools/--mcp-config are all variadic
# CLI options that greedily swallow any bare positional argument that
# follows them (verified: without this ordering, the trailing mission prompt
# silently vanishes into the preceding flag's value list instead of being
# passed to claude as the prompt).
# An operator can keep all its settings in one operator.json (see
# templates/operator.schema.json) instead of separate files. When it has one,
# that file is the only source; the separate files are for older squads.
operator_json() {
  local f="$LEGION_OPERATORS/$1/operator.json"
  [ -f "$f" ] && echo "$f"
}

# Prints one line per problem in an operator's operator.json, following
# templates/operator.schema.json. jq has no JSON Schema support, so the same
# rules are written out here; keep the two in step.
operator_json_problems() {
  local f="$1"
  jq empty "$f" 2>/dev/null || { echo "not valid JSON"; return; }
  jq -r '
    if type != "object" then "the top level must be an object" else
      ( (keys - ["$schema", "$comment", "model", "configMode", "scale", "allowedTools", "disallowedTools", "settings", "mcpServers"])[]
          | "unknown key \"\(.)\"" ),
      ( select(has("model") and ((.model | type) != "string" or .model == ""))
          | "model must be a non-empty string, like \"sonnet\"" ),
      ( select(has("configMode") and ((.configMode | IN("layered", "isolated")) | not))
          | "configMode must be \"layered\" or \"isolated\"" ),
      ( select(has("scale") and (.scale != true)
               and ((.scale | type) != "number" or .scale < 1 or (.scale | floor) != .scale))
          | "scale must be true (up to 5) or a whole number of at least 1" ),
      ( ("allowedTools", "disallowedTools") as $k
          | select(has($k) and ((.[$k] | type) != "array" or any(.[$k][]; type != "string" or . == "")))
          | "\($k) must be a list of non-empty strings" ),
      ( select(has("settings") and (.settings | type) != "object")
          | "settings must be an object" ),
      ( select(has("mcpServers")) | .mcpServers
          | if type != "object" then "mcpServers must be an object keyed by server name"
            else to_entries[]
              | select((.value | type) != "object" or ((.value | has("command")) or (.value | has("url")) | not))
              | "mcpServers.\(.key) needs a command or a url"
            end )
    end
  ' "$f"
}

# Checks one operator's operator.json (if it has one) and prints any problems.
# Returns 1 when there are problems, so launches can refuse to start.
check_operator() {
  local op="$1" f problems
  f="$(operator_json "$op")" || return 0
  problems="$(operator_json_problems "$f")"
  [ -z "$problems" ] && return 0
  echo "legion: .legion/operators/$op/operator.json has problems:" >&2
  printf '%s\n' "$problems" | sed 's/^/  - /' >&2
  return 1
}

cmd_check() {
  require_active
  local ops op failed=0 checked=0
  if [ $# -gt 0 ]; then ops="$*"; else
    ops="$(for d in "$LEGION_OPERATORS"/*/; do [ -d "$d" ] && basename "$d"; done)"
  fi
  for op in $ops; do
    op="$(operator_base "$op")"
    if [ -z "$(operator_json "$op")" ]; then echo "$op: no operator.json (uses separate files)"; continue; fi
    checked=$((checked + 1))
    if check_operator "$op"; then echo "$op: ok"; else failed=1; fi
  done
  [ "$failed" -eq 0 ] || exit 1
}

# A scalable operator has a `scale` file in its folder; the first
# non-comment line is the most copies that may run at once (5 if blank).
# Copy 1 is plain <operator>; extra copies are <operator>-2, <operator>-3 …
# and all of them share that one folder's definition, rules and settings.
scale_max() {
  local file="$LEGION_OPERATORS/$1/scale" max="" json
  if json="$(operator_json "$1")"; then
    max="$(jq -r 'if .scale == true then 5 elif (.scale | type) == "number" then .scale else empty end' "$json" 2>/dev/null)"
    [ -n "$max" ] && { echo "$max"; return 0; }
    return 1
  fi
  [ -f "$file" ] || return 1
  max="$(sed 's/#.*//' "$file" | xargs | awk '{print $1}')"
  case "$max" in
    '') echo 5 ;;
    *[!0-9]*|0) echo "legion: $file must hold a whole number above 0" >&2; return 1 ;;
    *) echo "$max" ;;
  esac
}

# The operator whose folder a position uses: itself, or for a copy like
# builder-2, the scalable operator it's a copy of.
operator_base() {
  local name="$1" base
  if [ -d "$LEGION_OPERATORS/$name" ]; then echo "$name"; return; fi
  base="${name%-*}"
  case "${name##*-}" in
    ''|*[!0-9]*) echo "$name"; return ;;
  esac
  if [ "$base" != "$name" ] && scale_max "$base" >/dev/null 2>&1; then echo "$base"; else echo "$name"; fi
}

operator_dir() {
  echo "$LEGION_OPERATORS/$(operator_base "$1")"
}

# An operator's own config-mode file (first non-comment line: layered or
# isolated) overrides the squad-wide LEGION_CONFIG_MODE for that operator.
config_mode() {
  local dir="$(operator_dir "$1")" mode="" json
  if json="$(operator_json "$(operator_base "$1")")"; then
    mode="$(jq -r '.configMode // empty' "$json" 2>/dev/null)"
  elif [ -f "$dir/config-mode" ]; then
    mode="$(sed 's/#.*//' "$dir/config-mode" | xargs | awk '{print $1}')"
  fi
  mode="${mode:-${LEGION_CONFIG_MODE:-layered}}"
  case "$mode" in
    layered|isolated) echo "$mode" ;;
    *) echo "legion: invalid config mode '$mode' for $1 (want layered or isolated)" >&2; exit 1 ;;
  esac
}

# Which Claude model a position runs on: the first non-comment line of its
# operator's `model` file (an alias like opus, sonnet or haiku, or a full
# model id), else LEGION_MODEL from .legion/squad, else claude's own default.
operator_model() {
  local dir="$(operator_dir "$1")" model="" json
  if json="$(operator_json "$(operator_base "$1")")"; then
    model="$(jq -r '.model // empty' "$json" 2>/dev/null)"
  elif [ -f "$dir/model" ]; then
    model="$(sed 's/#.*//' "$dir/model" | xargs | awk '{print $1}')"
  fi
  # Read the squad default from the file rather than the environment, so
  # squads whose activate script predates LEGION_MODEL still pick it up.
  [ -n "$model" ] || model="$(awk -F= '$1 == "LEGION_MODEL" { gsub(/"/, "", $2); print $2; exit }' "$LEGION_ROOT/squad" 2>/dev/null)"
  echo "$model"
}

claude_flags() {
  local operator="$1" operator_dir="$(operator_dir "$1")" flags="" json rule
  flags="$flags$(flag_from_list --add-dir "$LEGION_AO")"
  [ "$(config_mode "$operator")" = "isolated" ] && flags="$flags --setting-sources project,local"
  if json="$(operator_json "$(operator_base "$operator")")"; then
    # claude takes --settings and --mcp-config as files, so write this
    # operator's sections out under local/, which stays out of git.
    local gen="$LEGION_LOCAL/generated/$(operator_base "$operator")"
    mkdir -p "$gen"
    while IFS= read -r rule; do
      [ -n "$rule" ] && flags="$flags --allowedTools $(printf '%q' "$rule")"
    done <<EOF
$(jq -r '.allowedTools[]?' "$json")
EOF
    while IFS= read -r rule; do
      [ -n "$rule" ] && flags="$flags --disallowedTools $(printf '%q' "$rule")"
    done <<EOF
$(jq -r '.disallowedTools[]?' "$json")
EOF
    if jq -e 'has("settings")' "$json" >/dev/null; then
      jq '.settings' "$json" > "$gen/settings.json"
      flags="$flags --settings $(printf '%q' "$gen/settings.json")"
    fi
    if jq -e 'has("mcpServers")' "$json" >/dev/null; then
      jq '{mcpServers: .mcpServers}' "$json" > "$gen/mcp.json"
      flags="$flags --mcp-config $(printf '%q' "$gen/mcp.json")"
    fi
  else
    flags="$flags$(flag_from_list --allowedTools "$operator_dir/allowed-tools")"
    flags="$flags$(flag_from_list --disallowedTools "$operator_dir/disallowed-tools")"
    [ -f "$operator_dir/settings.json" ] && flags="$flags --settings $(printf '%q' "$operator_dir/settings.json")"
    [ -f "$operator_dir/mcp.json" ] && flags="$flags --mcp-config $(printf '%q' "$operator_dir/mcp.json")"
  fi
  local model
  model="$(operator_model "$operator")"
  [ -n "$model" ] && flags="$flags --model $(printf '%q' "$model")"
  echo "$flags"
}

# Every position (commander and every operator) is durable, not one-shot:
# the first launch creates a real conversation under a fresh uuid and
# remembers it in $LEGION_LOCAL/<position>; every launch after that
# reattaches to it. claude errors if --session-id names one already in use,
# and errors if --resume names one that's never existed (verified) — so
# which flag is correct depends entirely on whether we've launched this
# position before.
session_flag() {
  local id_file="$LEGION_LOCAL/$1"
  if [ -f "$id_file" ]; then
    echo "--resume $(cat "$id_file")"
  else
    local id
    id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    echo "$id" > "$id_file"
    echo "--session-id $id"
  fi
}

# An operator name that looks like a flag (e.g. "--help") would otherwise be
# accepted literally and spawn a real, oddly-named claude session — verified
# live: an agent probing `legion deploy --help` did exactly that.
valid_operator() {
  case "$1" in
    -*|*[!a-zA-Z0-9_-]*|'') return 1 ;;
    *) return 0 ;;
  esac
}

# Every position runs as a pane in one tmux window per squad, tiled into a
# grid. Legion finds panes by the @legion_addr and @legion_squad options it
# sets at launch, not by window name, so moving or re-tiling them is safe.

# This squad's panes, commander first, one per line:
#   <address> TAB <pane id> TAB <command>
squad_panes() {
  tmux list-panes -a -F '#{pane_id}	#{@legion_squad}	#{@legion_addr}	#{pane_current_command}' 2>/dev/null \
    | awk -F '\t' -v s="$LEGION_SQUAD_NAME" -v c="$LEGION_SQUAD_NAME-commander" '
        $2 != s || seen[$1]++ { next }
        { printf "%s\t%s\t%s\t%s\n", ($3 == c ? 0 : 1), $3, $1, $4 }
      ' | sort | cut -f2-
}

pane_of() {
  squad_panes | awk -F '\t' -v a="$1" '$1 == a { print $2; exit }'
}

squad_window() {
  tmux list-windows -a -F '#{window_id} #{@legion_grid}' 2>/dev/null \
    | awk -v s="$LEGION_SQUAD_NAME" '$2 == s { print $1; exit }'
}

# Mark a folder as trusted in Claude Code's config, the same record its
# "Do you trust this folder?" prompt saves when you say yes. Without it,
# every new session stops at that prompt and never checks in. Builds the new
# config in a temp file first so a jq failure can't leave it half-written.
trust_folder() {
  local dir="$1" config="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" tmp
  command -v jq >/dev/null 2>&1 || { echo "legion: jq not found — can't pre-trust $dir; accept the trust prompt in each pane instead" >&2; return 0; }
  [ -f "$config" ] || echo '{}' > "$config"
  [ "$(jq -r --arg d "$dir" '.projects[$d].hasTrustDialogAccepted // false' "$config" 2>/dev/null)" = "true" ] && return 0
  tmp="$(mktemp "$config.legion.XXXXXX")"
  if jq --arg d "$dir" '.projects[$d] = ((.projects[$d] // {}) + {hasTrustDialogAccepted: true})' "$config" > "$tmp"; then
    # Copy back over rather than mv, so a symlinked config (dotfiles) and its
    # permissions survive.
    cat "$tmp" > "$config"
    rm -f "$tmp"
    echo "trusted $dir in Claude Code ($config)"
  else
    rm -f "$tmp"
    echo "legion: couldn't update $config — accept the trust prompt in each pane instead" >&2
  fi
}

open_window() {
  local name="$1" cmd="$2" operator="$3"
  if [ -n "$(pane_of "$name")" ]; then
    echo "'$name' is already running — attach with: legion attach $operator" >&2
    return 0
  fi
  trust_folder "$(dirname "$LEGION_ROOT")"
  # Re-source activate inside the new pane before exec'ing claude, so the
  # Legion env (and therefore `legion` itself) is available to whatever the
  # session runs via its own Bash tool — a fresh tmux pane does not inherit
  # LEGION_ROOT etc. from the shell that called `legion commander`.
  local project_dir="$(dirname "$LEGION_ROOT")"
  local wrapped="cd $(printf '%q' "$project_dir") && . $(printf '%q' "$LEGION_ROOT/bin/activate") >/dev/null && exec $cmd"
  local window pane
  window="$(squad_window)"
  if [ -n "$window" ]; then
    pane="$(tmux split-window -d -P -F '#{pane_id}' -t "$window" "$wrapped")"
  elif [ -n "${TMUX:-}" ]; then
    pane="$(tmux new-window -P -F '#{pane_id}' -n "$LEGION_SQUAD_NAME" "$wrapped")"
  else
    pane="$(tmux new-session -d -P -F '#{pane_id}' -s "$LEGION_SQUAD_NAME" -n "$LEGION_SQUAD_NAME" -x 240 -y 60 "$wrapped")"
    echo "started detached tmux session '$LEGION_SQUAD_NAME' — see it with: legion grid"
  fi
  tmux set-option -p -t "$pane" @legion_squad "$LEGION_SQUAD_NAME" \
    \; set-option -p -t "$pane" @legion_addr "$name"
  if [ -z "$window" ]; then
    window="$(tmux display-message -p -t "$pane" '#{window_id}')"
    tmux set-option -w -t "$window" @legion_grid "$LEGION_SQUAD_NAME" \
      \; set-option -w -t "$window" pane-border-status top \
      \; set-option -w -t "$window" pane-border-format ' #{@legion_addr} '
  fi
  tmux select-layout -t "$window" tiled
}

cmd_init() {
  if [ -d .legion ]; then
    echo ".legion already exists here" >&2
    exit 1
  fi
  local squad
  squad="$(echo "${1:-$(basename "$PWD")}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')"
  [ -n "$squad" ] || squad="squad"
  if tmux list-panes -a -F '#{@legion_squad}' 2>/dev/null | awk -v s="$squad" '$0 == s { f = 1 } END { exit !f }'; then
    echo "'$squad-*' is already in use by another running squad on this machine — addresses would collide." >&2
    echo "pick an explicit, distinct name: legion init <squad-name>" >&2
    exit 1
  fi
  mkdir -p .legion/bin
  mkdir -p .legion/missions/todo .legion/missions/active .legion/missions/done
  mkdir -p .legion/operators .legion/pipelines
  touch .legion/missions/todo/.gitkeep .legion/missions/active/.gitkeep .legion/missions/done/.gitkeep
  touch .legion/operators/.gitkeep .legion/pipelines/.gitkeep
  local templates="${LEGION_TEMPLATES:-$HOME/.local/share/legion/templates}"
  [ -f "$templates/pipelines/README.md" ] && cp "$templates/pipelines/README.md" .legion/pipelines/README.md
  # So any Claude session in this project, not just the squad, writes
  # pipelines in the same format.
  if ! { [ -f CLAUDE.md ] && awk '/^## Legion pipelines/ { f = 1 } END { exit !f }' CLAUDE.md; }; then
    [ -s CLAUDE.md ] && printf '\n' >> CLAUDE.md
    cat >> CLAUDE.md <<'EOF'
## Legion pipelines

Pipelines live in `.legion/pipelines/<name>.md` as Mermaid flowcharts. Follow
`.legion/pipelines/README.md` when writing or changing one.
EOF
    echo "added a 'Legion pipelines' note to CLAUDE.md"
  fi

  # Committed — shared via git, one squad per project.
  cat > .legion/squad <<EOF
LEGION_SQUAD_NAME="$squad"
# layered: every session inherits the normal user/project/local Claude config.
# isolated: drop the user's global ~/.claude config for every session in this
#   squad (--setting-sources project,local) — per-operator settings.json
#   (below) becomes the only settings source that matters for whoever has one.
# This is the squad default; operators/<operator>/config-mode overrides it.
LEGION_CONFIG_MODE="layered"
# Default Claude model for every session (opus, sonnet, haiku or a full model
# id). Blank uses claude's own default; operators/<operator>/model overrides it.
LEGION_MODEL=""
EOF
  cat > .legion/log.md <<EOF
# $squad — log

Shared context, decisions and handoff notes for this squad. \`commander\`
reads this on startup and is expected to keep it updated — commit it like
any other doc. The actual mission backlog lives in missions/todo,
missions/active, missions/done, not here.
EOF
  cat > .legion/doctrine.md <<EOF
# $squad — doctrine

Squad-wide conventions, values and working style. Every session — commander
and every operator — gets this spliced into its startup prompt, so put
anything here that should apply to everyone, not just one operator.
EOF
  cat > .legion/ao <<'EOF'
# One absolute path per line. Extra directories/repos this squad is allowed
# to access beyond the project root (its Area of Operations), passed as
# --add-dir to every session (commander and operators). Lines starting with
# # and blank lines are ignored.
EOF

  # Machine-local — a resume session-id and live roster status mean nothing
  # on another clone, so keep them out of git via .legion's own .gitignore.
  cat > .legion/.gitignore <<'EOF'
local
roster
worktrees
EOF

  cat > .legion/bin/activate <<'ACTIVATE'
# Source this file — do not execute: source .legion/bin/activate
if [ -n "${LEGION_ROOT:-}" ]; then
  echo "already inside a Legion shell (${LEGION_SQUAD_NAME:-?}) — deactivate first" >&2
  return 1 2>/dev/null || exit 1
fi

export LEGION_ROOT="$(pwd)/.legion"
. "$LEGION_ROOT/squad"
export LEGION_SQUAD_NAME LEGION_CONFIG_MODE LEGION_MODEL
export LEGION_ROSTER="$LEGION_ROOT/roster"
export LEGION_LOG="$LEGION_ROOT/log.md"
export LEGION_MISSIONS="$LEGION_ROOT/missions"
export LEGION_OPERATORS="$LEGION_ROOT/operators"
export LEGION_DOCTRINE="$LEGION_ROOT/doctrine.md"
export LEGION_AO="$LEGION_ROOT/ao"
export LEGION_PIPELINES="$LEGION_ROOT/pipelines"
export LEGION_LOCAL="$LEGION_ROOT/local"
mkdir -p "$LEGION_ROSTER" "$LEGION_OPERATORS" "$LEGION_PIPELINES" "$LEGION_LOCAL"
mkdir -p "$LEGION_MISSIONS/todo" "$LEGION_MISSIONS/active" "$LEGION_MISSIONS/done"

_legion_old_ps1="$PS1"
export PS1="(legion:$LEGION_SQUAD_NAME) $PS1"

deactivate() {
  export PS1="$_legion_old_ps1"
  unset LEGION_ROOT LEGION_SQUAD_NAME LEGION_CONFIG_MODE LEGION_MODEL LEGION_ROSTER LEGION_LOG LEGION_MISSIONS LEGION_OPERATORS LEGION_DOCTRINE LEGION_AO LEGION_PIPELINES LEGION_LOCAL
  unset -f deactivate
  unset _legion_old_ps1
}
ACTIVATE

  echo "created .legion/ (squad: $squad)"
  echo "commit .legion/ — squad, log.md, doctrine.md, ao, missions/, operators/, pipelines/, .gitignore and bin/ are meant to be shared;"
  echo "local (session-ids) and roster/ (live status) are machine-local and already excluded"
  echo "per-operator config (allowed-tools, disallowed-tools, settings.json, mcp.json) is optional —"
  echo "add files under operators/<operator>/ yourself, e.g. operators/planner/disallowed-tools"
  echo "next: source .legion/bin/activate"
}

cmd_commander() {
  require_active
  local mission="$*"
  local mission_display="${mission:-none yet — wait for instructions from the human or a message}"
  local addr="$LEGION_SQUAD_NAME-commander"
  local prompt
  prompt="You are '$addr', the commander of a small squad, run on mission command — you set direction and goals, not method. You decide what operators this squad needs — you are not limited to planner/builder/reviewer, and you may start with no one but yourself. Deploy operators and give each their piece of the mission (the what and why); trust their expertise for the how, and don't dictate method to them. Operators coordinate directly with each other for their specific skills — you do not need to broker that, and should not try to. Your job is direction, arbitration and perspective: be the tiebreaker when operators disagree or a decision needs someone with the whole mission in view, and give mission-level context to any operator who asks for it. Operators still check in with you and report when their mission is done, so you keep overall awareness without being in the loop for every exchange. You own the mission backlog — it's fine for an operator to sit idle if you have nothing queued for them; that is not a problem to solve. Your shell already has legion ready to use directly — do not run 'source .legion/bin/activate' yourself, you're already in one and it will just error. To deploy an operator, run this yourself via your shell: legion deploy <operator> \"<mission>\" — it will be addressed as '$LEGION_SQUAD_NAME-<operator>' and checks in with you. Use 'legion roster' to see who has checked in, 'legion list' for tmux windows, 'legion stand-down <operator>' to let someone go.

The mission backlog lives as files under $LEGION_MISSIONS/{todo,active,done}/, committed to the repo — this is the real queue, not something you keep only in your head. One markdown file per mission, named like 0001-short-slug.md (zero-padded, increasing — check existing files across all three folders before picking the next number so you never reuse one). File format: a couple of header lines, a blank line, then the mission body:
operator: <operator this is for, or 'unassigned'>
created: <ISO 8601>
pipeline: <name, only if this mission should hand off between stages on its own — see below>

<mission description>

Workflow: write new missions into todo/ as you think of them (or as asked of you) — you don't have to dispatch them immediately. To actually assign one, move its file from todo/ to active/ (add 'assigned: <name>' to the header) and hand the same mission text to that operator (deploying them if new, or messaging them with it if already running and free). When an operator reports a mission done, move its file from active/ to done/. If you stand down an operator mid-mission, move their file back from active/ to todo/ so the work isn't lost. This is a queue per operator, not a single shared queue — the same operator shouldn't have two files in active/ at once.

Every mission that changes project files gets its own git worktree: a separate checkout of the project on its own branch, so two missions (or a paused one) never leave edits in each other's way. When you move such a mission to active/, run 'legion mission start <number>' first — it creates the worktree, adds 'worktree:', 'branch:' and 'base:' lines to the mission file, and prints the worktree path; include that path when you hand the mission over. Mission files, the roster and the log always stay in the project root's .legion/, never the worktree's copy. When reviewer approves, run 'legion mission finish <number>': it fast-forwards the base branch to the mission branch and removes the worktree. If it refuses because the base branch moved on, send the mission back to builder to rebase onto the base branch in the worktree, then finish again. Then move the file to done/. A paused mission keeps its worktree as is; nothing needs saving.

Some operators are scalable: their operator.json has a 'scale' setting (true for up to 5, or a number), or older squads have a 'scale' file in their folder. Every copy uses that folder's definition and rules; copy 1 is '$LEGION_SQUAD_NAME-<operator>' and extras are '$LEGION_SQUAD_NAME-<operator>-2' and up. When independent missions are waiting on a busy scalable operator, run 'legion scale up <operator> \"<mission>\"' to start the next free copy with that mission, and 'legion scale <operator>' to see which copies are running. Each copy takes one mission at a time, in that mission's own worktree. When a copy has nothing left in active/, stand it down with 'legion stand-down <operator>-<n>'. Only scale up for work that can really run side by side; missions that touch the same files still merge one at a time, so the later one will need a rebase.

Operators are free to message each other directly whenever one needs another's expertise — that's normal, not something you need to arrange. For a known, repeatable sequence you want formalized rather than ad hoc, declare a pipeline. Pipelines are Markdown files, $LEGION_PIPELINES/<name>.md, holding a Mermaid flowchart. Each box is a step, named after the operator who does it (builder[builder: build it]); the first box is the first step. A diamond is a statement that is either true or false (approved{the change is approved}), decided by whoever just finished, and its arrows are labelled yes or no. A labelled arrow out of a step is only followed when its label is true; an unlabelled arrow is the normal next step. A rounded box named done ends the pipeline. $LEGION_PIPELINES/README.md has the full rules. An older squad may still have a plain list at $LEGION_PIPELINES/<name> instead: one operator per line, in order, with # lines as comments. Operators named in a pipeline don't need to exist yet; they get deployed as the pipeline reaches them. Give a mission file a 'pipeline: <name>' header field and operators hand it off directly to the next stage when they finish — the mission file still records every step (that's the audit trail), and whoever hands off also sends you a one-line FYI, so you stay aware without brokering it. A pipeline is a declared, named sequence; direct operator-to-operator collaboration outside one is just how this squad normally works.

Roster status also lives as files, one per operator, at $LEGION_ROSTER/<operator>.md — not deleted when someone stands down, just updated, so it doubles as a record of who has ever been on this squad. On a message starting with CHECK-IN:, parse name/operator/role and write/update that operator's file:
name: <session name>
role: <their role, as they described it>
status: active
last_seen: <ISO 8601>
When asked who is active, cross-check the files against ListAgents and report the live ones; for any file whose name no longer appears there, set status: stood-down without deleting the file. This tracks presence only — what someone is working on lives in $LEGION_MISSIONS/active/ instead, don't duplicate it here.

There is also a shared log file at $LEGION_LOG, committed to the repo, for freeform context and decisions that don't fit the mission or roster format — read it at startup, keep it updated. \$LEGION_OPERATORS/<operator>/definition.md is that operator's persistent identity and expertise — worth reading yourself when deciding who on the squad to point at a given need, since that's how operators know each other's strengths well enough to reach out directly. Example operator definitions (planner/builder/reviewer) live at ~/.local/share/legion/templates/operators/ if you want a starting point when defining a new one — copy and adapt, or draft one from scratch; ask the human if you want help thinking one through. Each operator's config is its own — model, tool permissions, settings and MCP servers are set per operator, not squad-wide, in \$LEGION_OPERATORS/<operator>/operator.json (schema: ~/.local/share/legion/templates/operator.schema.json; older squads use separate files instead). Its allowedTools and disallowedTools lists hold Claude Code tool patterns, e.g. \"Edit(**/src/**)\" (see 'claude --help' for the syntax), and restrict what that specific operator can touch, e.g. a planner that should only ever write the plan, never code. There is no single pattern meaning 'only this folder' — write concrete deny patterns for wherever this repo's real code lives. If you change an operator.json, run 'legion check <operator>' before deploying it; legion refuses to start an operator whose operator.json has problems. The human directing you may talk to you two ways: attached directly to this window, or as a cross-session message (from another Claude Code session addressing you as '$addr') — treat both the same. Overall mission: $mission_display"
  [ -s "$LEGION_DOCTRINE" ] && prompt="$prompt

This squad's doctrine:
$(cat "$LEGION_DOCTRINE")"
  [ -s "$LEGION_OPERATORS/commander/definition.md" ] && prompt="$prompt

Additional instructions for you specifically:
$(cat "$LEGION_OPERATORS/commander/definition.md")"
  check_operator commander || exit 1
  config_mode commander >/dev/null || exit 1
  local claude_cmd="claude --name $(printf '%q' "$addr") $(session_flag commander) --append-system-prompt $(printf '%q' "$prompt")"
  local kickoff="${LEGION_KICKOFF:-}"
  [ -n "$mission" ] && kickoff="Get started: $mission"
  [ -n "$kickoff" ] && claude_cmd="$claude_cmd $(printf '%q' "$kickoff")"
  claude_cmd="$claude_cmd$(claude_flags commander)"
  open_window "$addr" "$claude_cmd" "commander"
}

defined_operators() {
  local dir name
  for dir in "$LEGION_OPERATORS"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    [ "$name" = "commander" ] && continue
    valid_operator "$name" && echo "$name"
  done
}

# `legion deploy` with no operator: start commander and every defined
# operator with no mission. Each checks in with who it is and what it does,
# and commander prints the roll call once everyone has answered.
cmd_rollcall() {
  local ops
  ops="$(defined_operators)"
  [ -n "$ops" ] || { echo "no operators defined yet — add a folder per operator under .legion/operators/, or: legion deploy <operator> [mission...]" >&2; exit 1; }
  local list
  list="$(echo "$ops" | paste -sd, - | sed 's/,/, /g')"
  LEGION_KICKOFF="Roll call. No mission yet. You're expecting check-ins from: $list. As each CHECK-IN arrives, update the roster as usual. Once all of them have checked in (or after a few minutes, noting who didn't), print a short roll call here: each operator's name and, in a line, who they are and what they do. Then wait for a mission from the human." \
    cmd_commander
  local op
  for op in $ops; do
    LEGION_KICKOFF="wait for a mission — this is a roll call, there is no work yet." \
      cmd_deploy "$op"
  done
  echo "roll call started: commander + $list"
  cmd_grid
}

cmd_deploy() {
  require_active
  if [ $# -eq 0 ]; then cmd_rollcall; return; fi
  local operator="${1:-}"
  valid_operator "$operator" || { echo "usage: legion deploy <operator> [mission...] (operator must be a plain name, not a flag)" >&2; exit 1; }
  shift
  local mission="$*"
  local mission_display="${mission:-none yet — wait for instructions}"
  local addr="$LEGION_SQUAD_NAME-$operator"
  local base max
  base="$(operator_base "$operator")"
  if [ "$base" != "$operator" ]; then
    max="$(scale_max "$base")" || exit 1
    [ "${operator##*-}" -ge 2 ] && [ "${operator##*-}" -le "$max" ] \
      || { echo "legion: $base can run at most $max copies ($base, $base-2 … $base-$max)" >&2; exit 1; }
  fi
  local commander_addr="$LEGION_SQUAD_NAME-commander"
  local prompt
  prompt="You are '$addr' on a small squad commanded by '$commander_addr', run on mission command: commander sets direction and goals, you own the how. Message '$commander_addr' to check in, to report your mission done, to ask for mission-level perspective, or to raise anything that needs a tiebreaker — a decision or disagreement only commander should settle. For your own domain, decide your approach yourself; commander gave you the what, not the method. When you need another operator's specific expertise, message them directly — this is normal, not an exception, and commander does not need to broker it. Call ListAgents to see who else is checked in, and read \$LEGION_OPERATORS/<their-operator-name>/definition.md if you want to know what they're good at before reaching out. Before doing anything else, call ListAgents to learn your own session name, then SendMessage to '$commander_addr': \"CHECK-IN: name=<your name> operator=$operator role=<one or two sentences, in your own words, on who you are and what you do on this squad — from your operator definition if you have one> mission=$mission_display\". Check in every time you are started, including when this conversation is resumed: commander may be a brand-new session that has never heard from you, so an earlier check-in in this conversation does not count — send a fresh one. Commander may start at the same moment you do, so if '$commander_addr' isn't in ListAgents yet, wait about 10 seconds and look again, for up to about a minute; only if it still isn't there, skip the check-in and carry on. Otherwise, check in once per start, not repeatedly. Your mission: $mission_display

If your mission file has a 'worktree:' header, that folder is where this mission's code lives: read, edit, test and commit there (use its paths for file edits, and cd into it for shell commands). Don't touch the project root's copy of those files for this mission. Mission files, the roster and the log stay in the project root's .legion/ — update those there, never in the worktree.

If the mission file you were given has a 'pipeline: <name>' header, read that pipeline to find your step in it. Pipelines are Markdown files, $LEGION_PIPELINES/<name>.md, holding a Mermaid flowchart. Each box is a step, named after the operator who does it (builder[builder: build it]); the first box is the first step. A diamond is a statement that is either true or false (approved{the change is approved}), decided by whoever just finished, and its arrows are labelled yes or no. A labelled arrow out of a step is only followed when its label is true; an unlabelled arrow is the normal next step. A rounded box named done ends the pipeline. $LEGION_PIPELINES/README.md has the full rules. An older squad may still have a plain list at $LEGION_PIPELINES/<name> instead: one operator per line, in order, with # lines as comments. When you finish your step, decide any question that follows it and follow the arrows to the next step. If that step belongs to another operator, hand off directly — update the mission file (move it if commander's convention has you do that, set operator/assigned to the next stage, add a short note of what you did), deploy that operator via 'legion deploy <operator> \"...\"' if they are not already running or SendMessage them directly if they are, and separately send '$commander_addr' a one-line FYI that you handed off. If the next stage is a scalable operator (a 'scale' setting in its operator.json, or a 'scale' file in older squads), it may be running as several copies — '$LEGION_SQUAD_NAME-<operator>', '$LEGION_SQUAD_NAME-<operator>-2' and so on, shown in ListAgents. Hand off to a copy that has no mission in \$LEGION_MISSIONS/active/ assigned to it; if every copy is busy, ask '$commander_addr' to scale up instead of queueing behind a busy copy. If the arrows lead to done, or the mission has no pipeline field, report back to '$commander_addr' when your mission is done — and along the way, reach out to any other operator directly whenever their expertise would help."
  [ -s "$LEGION_DOCTRINE" ] && prompt="$prompt

This squad's doctrine:
$(cat "$LEGION_DOCTRINE")"
  [ -s "$(operator_dir "$operator")/definition.md" ] && prompt="$prompt

Your operator definition:
$(cat "$(operator_dir "$operator")/definition.md")"
  check_operator "$(operator_base "$operator")" || exit 1
  config_mode "$operator" >/dev/null || exit 1
  local claude_cmd="claude --name $(printf '%q' "$addr") $(session_flag "$operator") --append-system-prompt $(printf '%q' "$prompt")"
  # Always send an opening message, even on a resume with no mission: without
  # one a resumed session just sits there, and it must check in every start.
  local kickoff="You have just been started (or restarted). Check in with commander now, as your instructions describe — every start, even if this conversation already shows an earlier check-in."
  if [ -n "$mission" ]; then
    kickoff="$kickoff Then get started: $mission"
  else
    kickoff="$kickoff Then ${LEGION_KICKOFF:-wait for a mission.}"
  fi
  claude_cmd="$claude_cmd $(printf '%q' "$kickoff")"
  claude_cmd="$claude_cmd$(claude_flags "$operator")"
  open_window "$addr" "$claude_cmd" "$operator"
}

cmd_squad() {
  require_active
  local mission="${*:-no overall mission specified yet}"
  cmd_commander "$mission"
  cmd_deploy planner "Break the overall mission into a concrete plan for commander to hand out. Overall mission: $mission"
  cmd_deploy builder "Implement whatever commander assigns you from the plan. Ask planner or reviewer directly if you need their input."
  cmd_deploy reviewer "Review whatever commander sends you and report issues back to commander. Message builder directly if you need to clarify something with them."
  cmd_grid
}

cmd_roster() {
  require_active
  local f found=0
  for f in "$LEGION_ROSTER"/*.md; do
    [ -e "$f" ] || continue
    found=1
    echo "== $(basename "$f" .md) =="
    cat "$f"
    echo
  done
  [ "$found" -eq 1 ] || echo "(no operators checked in yet)"
}

cmd_attach() {
  require_active
  valid_operator "${1:-}" || { echo "usage: legion attach <operator>" >&2; exit 1; }
  local name="$LEGION_SQUAD_NAME-$1" pane
  pane="$(pane_of "$name")"
  [ -n "$pane" ] || { echo "'$name' is not running" >&2; exit 1; }
  tmux select-window -t "$pane" \; select-pane -t "$pane"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$pane"
  else
    tmux attach-session -t "$pane"
  fi
}

cmd_capture() {
  require_active
  valid_operator "${1:-}" || { echo "usage: legion capture <operator> [lines]" >&2; exit 1; }
  local name="$LEGION_SQUAD_NAME-$1" pane
  pane="$(pane_of "$name")"
  [ -n "$pane" ] || { echo "'$name' is not running" >&2; exit 1; }
  if [ -n "${2:-}" ]; then
    tmux capture-pane -t "$pane" -p -S "-$2"
  else
    tmux capture-pane -t "$pane" -p
  fi
}

cmd_standdown() {
  require_active
  if [ $# -eq 0 ]; then cmd_standdown_all; return; fi
  valid_operator "${1:-}" || { echo "usage: legion stand-down [operator]" >&2; exit 1; }
  local name="$LEGION_SQUAD_NAME-$1" pane window
  pane="$(pane_of "$name")"
  [ -n "$pane" ] || { echo "'$name' not found" >&2; exit 1; }
  window="$(squad_window)"
  tmux kill-pane -t "$pane"
  [ -n "$window" ] && tmux select-layout -t "$window" tiled 2>/dev/null
  return 0
}

# Stops operators before commander, so commander isn't left running while
# they disappear. Each keeps its saved conversation, so the next
# `legion deploy` picks up where it left off.
cmd_standdown_all() {
  local rows addr pane stopped=""
  rows="$(squad_panes)"
  [ -n "$rows" ] || { echo "no panes running for squad '$LEGION_SQUAD_NAME'"; return 0; }
  while IFS="$(printf '\t')" read -r addr pane _; do
    [ "$addr" = "$LEGION_SQUAD_NAME-commander" ] && continue
    tmux kill-pane -t "$pane" && stopped="$stopped ${addr#"$LEGION_SQUAD_NAME"-}"
  done <<EOF
$rows
EOF
  pane="$(pane_of "$LEGION_SQUAD_NAME-commander")"
  [ -n "$pane" ] && tmux kill-pane -t "$pane" && stopped="$stopped commander"
  echo "stood down:$stopped"
}

# Finds a mission file by number (5, 0005) or full name, active/ first.
mission_file() {
  local id="$1" n f
  case "$id" in
    *[!0-9]*) n="$id" ;;
    *) n="$(printf '%04d' "$((10#$id))")" ;;
  esac
  for f in "$LEGION_MISSIONS/active/$n"*.md "$LEGION_MISSIONS/todo/$n"*.md "$LEGION_MISSIONS/done/$n"*.md; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

# Sets "key: value" in a mission file's header (the lines before the first
# blank line), replacing the key if it's already there.
set_header() {
  local file="$1" key="$2" value="$3" tmp
  tmp="$(mktemp)"
  awk -v k="$key" -v v="$value" '
    !done && index($0, k ": ") == 1 { print k ": " v; done = 1; next }
    !done && $0 == "" { print k ": " v; done = 1 }
    { print }
    END { if (!done) print k ": " v }
  ' "$file" > "$tmp" && cat "$tmp" > "$file"
  rm -f "$tmp"
}

# Each mission that changes code gets its own git worktree under
# .legion/worktrees/, on branch mission/<name>, so a paused or parallel
# mission can't leave edits in another's way. finish only fast-forwards: if
# the base branch has moved on, the mission branch has to be rebased first,
# which keeps history linear and never merges on anyone's behalf.
cmd_mission() {
  require_active
  local sub="${1:-}" id="${2:-}"
  case "$sub" in
    start|finish) [ -n "$id" ] || { echo "usage: legion mission $sub <number>" >&2; exit 1; } ;;
    *) echo "usage: legion mission start|finish <number>" >&2; exit 1 ;;
  esac
  local root file slug branch path base current
  root="$(dirname "$LEGION_ROOT")"
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 \
    || { echo "legion: $root isn't a git repo — mission worktrees need one" >&2; exit 1; }
  file="$(mission_file "$id")" || { echo "no mission file matching '$id'" >&2; exit 1; }
  slug="$(basename "$file" .md)"
  branch="mission/$slug"
  path="$LEGION_ROOT/worktrees/$slug"
  current="$(git -C "$root" rev-parse --abbrev-ref HEAD)"
  case "$sub" in
    start)
      if [ -d "$path" ]; then echo "$path"; return 0; fi
      awk '$0 == "worktrees" { f = 1 } END { exit !f }' "$LEGION_ROOT/.gitignore" 2>/dev/null \
        || echo "worktrees" >> "$LEGION_ROOT/.gitignore"
      git -C "$root" worktree add -q -b "$branch" "$path" "$current" || exit 1
      set_header "$file" worktree "$path"
      set_header "$file" branch "$branch"
      set_header "$file" base "$current"
      echo "$path"
      ;;
    finish)
      [ -d "$path" ] || { echo "no worktree for $slug" >&2; exit 1; }
      [ -z "$(git -C "$path" status --porcelain)" ] \
        || { echo "$path has uncommitted changes — commit or discard them first" >&2; exit 1; }
      base="$(awk -F': ' '$0 == "" { exit } $1 == "base" { print $2; exit }' "$file")"
      base="${base:-$current}"
      [ "$current" = "$base" ] \
        || { echo "the project root is on '$current', not '$base' — switch it back first" >&2; exit 1; }
      git -C "$root" -c advice.diverging=false merge --ff-only -q "$branch" 2>/dev/null \
        || { echo "can't fast-forward $base to $branch — rebase first: cd $path && git rebase $base" >&2; exit 1; }
      git -C "$root" worktree remove "$path" && git -C "$root" branch -q -d "$branch"
      set_header "$file" worktree "(merged into $base and removed)"
      echo "merged $branch into $base"
      ;;
  esac
}

cmd_scale() {
  require_active
  local sub="${1:-}" op max n running addr
  case "$sub" in
    up) op="${2:-}"; shift 2 2>/dev/null || true ;;
    *) op="$sub"; sub="status" ;;
  esac
  valid_operator "$op" || { echo "usage: legion scale <operator> | legion scale up <operator> [mission...]" >&2; exit 1; }
  max="$(scale_max "$op")" || { echo "legion: $op isn't scalable — add a 'scale' file to .legion/operators/$op/ (blank means up to 5)" >&2; exit 1; }
  running="$(squad_panes | awk -F '\t' -v p="$LEGION_SQUAD_NAME-$op" '$1 == p || (index($1, p "-") == 1 && substr($1, length(p) + 2) ~ /^[0-9]+$/) { print $1 }')"
  if [ "$sub" = "status" ]; then
    echo "$op: $(printf '%s\n' "$running" | awk NF | wc -l | xargs) of $max running"
    printf '%s\n' "$running" | awk NF | sed 's/^/  /'
    return 0
  fi
  n=1
  while [ "$n" -le "$max" ]; do
    [ "$n" -eq 1 ] && addr="$op" || addr="$op-$n"
    if ! printf '%s\n' "$running" | awk -v a="$LEGION_SQUAD_NAME-$addr" '$0 == a { f = 1 } END { exit !f }'; then
      cmd_deploy "$addr" "$@"
      return
    fi
    n=$((n + 1))
  done
  echo "legion: all $max copies of $op are already running" >&2
  exit 1
}

cmd_list() {
  require_active
  tmux list-sessions >/dev/null 2>&1 || { echo "no tmux server running"; return 0; }
  local out
  out="$(squad_panes | awk -F '\t' '{ printf "%s  %s  (%s)\n", $1, $2, $3 }')"
  if [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    echo "no panes running for squad '$LEGION_SQUAD_NAME'"
  fi
}

cmd_grid() {
  require_active
  local window
  window="$(squad_window)"
  [ -n "$window" ] || { echo "no panes running for squad '$LEGION_SQUAD_NAME'" >&2; exit 1; }
  tmux select-layout -t "$window" tiled \; select-window -t "$window"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$window" 2>/dev/null || true
  else
    tmux attach-session -t "$window"
  fi
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  commander) shift; cmd_commander "$@" ;;
  deploy) shift; cmd_deploy "$@" ;;
  squad) shift; cmd_squad "$@" ;;
  roster) cmd_roster ;;
  attach) shift; cmd_attach "$@" ;;
  capture) shift; cmd_capture "$@" ;;
  stand-down) shift; cmd_standdown "$@" ;;
  list) cmd_list ;;
  check) shift; cmd_check "$@" ;;
  scale) shift; cmd_scale "$@" ;;
  mission) shift; cmd_mission "$@" ;;
  grid) cmd_grid ;;
  *) usage ;;
esac

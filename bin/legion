#!/usr/bin/env bash
# legion — Claude Code squad over tmux, run on mission command. One squad
# per project. Commander sets direction/goals and arbitrates; operators own
# the how and coordinate directly with each other for their expertise.
#
# Nothing but `init` works until a project has been activated:
#   legion init [squad-name]         # once, creates ./.legion (commit it — see log.md)
#   source .legion/bin/activate      # per shell — scopes roster/session-id, gates commands
#   legion squad "ship the thing"
#   deactivate                       # defined by the sourced script
set -euo pipefail

LEGION_SRC="https://github.com/joeboylson/legion"
# Prefixes every squad's tmux session name, so it's visually distinct from
# unrelated sessions and legion session --all can group by it. No colon —
# tmux itself uses ':' as the session:window.pane separator in targets, so
# a session literally named with one risks misparsing anywhere it's used
# as a -t argument.
LEGION_TAG="[LEGION]"

require_active() {
  if [ -z "${LEGION_ROOT:-}" ]; then
    echo "not inside an activated Legion shell — run: source .legion/bin/activate" >&2
    echo "(no ./.legion yet? run: legion init)" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
legion — Claude Code squad over tmux, run on mission command, scoped per project

  legion init [squad-name]      create ./.legion (roster/missions dirs + activate script)
  legion src                    print where legion's source code lives
  legion demo [folder]          watch a squad paint a mural together (runs in its own folder)
  legion mcp [--role human --project <path>]   run legion's MCP server (squad sessions get it automatically)
  legion session [name] [--all]      jump to a squad's tmux session by name, or pick from a list; --all for every tmux session, not just squads
  legion session detach              leave tmux entirely, back to a plain shell — every session keeps running
  legion dash [--once]               live view of every squad on this machine: each session's state, last actions and screen, and channel traffic
  legion dash --web [--port 7580] [--host <ip>]   the same view as a web page, for any browser that can reach this machine

Once activated (source .legion/bin/activate):
  legion commander [mission...]     hand the squad a goal — the default way to start work; it decides whether to do it itself or deploy operators
  legion deploy                     roll call: start commander + every operator in .legion/operators/, no mission
  legion deploy <operator> [mission...]   you already know who should do this piece — starts that operator (and commander, if it isn't up yet)
  legion squad [mission...]         deploy commander + planner + builder + reviewer
  legion roster                     show roster/*.md (who has checked in)
  legion list                       show this squad's tmux windows
  legion message send <position> <text...>   message another position (file-based, not SendMessage)
  legion message wait|read|log      wait for, read, or list your messages
  legion check [operator...]        check operator.json files against the schema
  legion grid                       open one tmux window tiling every position
  legion mission create <slug> <description...> [--pipeline <name>]   write a new mission into todo/, checking the pipeline exists first
  legion mission start <n>          give mission <n> its own git worktree and branch
  legion mission finish <n>         fast-forward the base branch to it and remove the worktree
  legion attach <operator>           jump to an operator's tmux window
  legion capture <operator> [lines]  read an operator's tmux pane without attaching
  legion scale <operator>           show how many copies of a scalable operator are running
  legion scale up <operator> [mission...]   start its next free copy (<operator>-2, …)
  legion stand-down                 stop every position in this squad
  legion stand-down <operator>       stop one position and close its tile
  legion channel open [--port <n>] [--key <k>]      accept relays from other squads on a port
  legion channel subscribe <host:port> --team <name> [--key <k>]   relay to another squad's channel
  legion channel send <team> [--operator <name>] <text...>   relay a message to a connected team (default: their commander)
  legion channel peers                              show teams this channel knows about
  legion channel close                              stop this squad's channel daemon
  legion activity tail [n]          watch every tool call any position makes, live
  legion activity tail --all [n]    the same for every squad running on this machine; works from any shell
  legion refresh [--stay]           (from a squad session) clear this conversation when the turn ends, then restart from its handoff note (--stay: stay idle)
  legion wrap-up                    end of day: every position stops at a good point, writes a handoff note and clears; the next start picks up from the notes
  deactivate                        leave the shell (from the sourced script)
EOF
}

# Reads a plain-text file (one entry per line, # comments, blank lines
# skipped) and echoes it back as repeated "<flag> <value>" pairs.
flag_from_list() {
  local flag="$1" file="$2" out="" line
  [ -f "$file" ] || { echo ""; return 0; }
  while IFS= read -r line; do
    line="${line%%#*}"
    line="$(echo "$line" | xargs)"
    [ -n "$line" ] && out="$out $flag $(printf '%q' "$line")"
  done < "$file"
  echo "$out"
}

# Config is per operator, not per squad: each operator gets its own optional
# allowed-tools/disallowed-tools/settings.json/mcp.json under
# $LEGION_OPERATORS/<operator>/ — e.g. a planner can be denied Edit on the
# actual code while commander and builder keep full access. AO (directory
# access) and the layered/isolated split stay squad-wide; everything else is
# per operator.
# IMPORTANT: this must always be the LAST thing appended to a claude_cmd —
# --add-dir/--allowedTools/--disallowedTools/--mcp-config are all variadic
# CLI options that greedily swallow any bare positional argument that
# follows them (verified: without this ordering, the trailing mission prompt
# silently vanishes into the preceding flag's value list instead of being
# passed to claude as the prompt).
# An operator can keep all its settings in one operator.json (see
# templates/operator.schema.json) instead of separate files. When it has one,
# that file is the only source; the separate files are for older squads.
operator_json() {
  local f="$LEGION_OPERATORS/$1/operator.json"
  [ -f "$f" ] && echo "$f"
}

# A squad can keep all its settings in one .legion/legion.json (see
# templates/legion.schema.json) instead of squad, ao and the separate
# per-operator files. Squads without one keep working as before.
squad_json() {
  local f="$LEGION_ROOT/legion.json"
  [ -f "$f" ] && echo "$f"
}

# legion.json is committed, but each clone keeps its repos somewhere else, so
# a git-ignored .legion/legion.local.json adds this machine's addDirs on top.
# It only applies alongside a legion.json.
squad_local_json() {
  local f="$LEGION_ROOT/legion.local.json"
  [ -n "$(squad_json)" ] && [ -f "$f" ] && echo "$f"
}

# Prints one line per problem in legion.local.json. It may only add folders.
squad_local_json_problems() {
  local f="$1"
  jq empty "$f" 2>/dev/null || { echo "not valid JSON"; return; }
  jq -r '
    if type != "object" then "the top level must be an object" else
      ( (keys - ["$schema", "$comment", "addDirs"])[]
          | "unknown key \"\(.)\" (legion.local.json only holds addDirs; shared settings go in legion.json)" ),
      ( select(has("addDirs") and ((.addDirs | type) != "array" or any(.addDirs[]; type != "string" or (startswith("/") | not))))
          | "addDirs must be a list of absolute paths" )
    end
  ' "$f"
}

# An operator's settings as legion uses them: legion.json's defaults (or its
# commander block, for commander) with the operator's own operator.json on
# top. Lists of tool rules are joined, objects are merged, and any other value
# in operator.json replaces the default. Prints the path of a generated file,
# or returns 1 when the squad has neither file, so older squads fall back to
# their separate files.
operator_config() {
  local op="$1" own sj ownj='{}' squadj='{}' out
  own="$(operator_json "$op")"
  sj="$(squad_json)"
  [ -n "$own" ] || [ -n "$sj" ] || return 1
  [ -n "$own" ] && ownj="$(cat "$own")"
  [ -n "$sj" ] && squadj="$(cat "$sj")"
  out="$LEGION_LOCAL/generated/$op/config.json"
  mkdir -p "$(dirname "$out")"
  jq -n --arg op "$op" --argjson own "$ownj" --argjson squad "$squadj" '
    ($squad | if $op == "commander" then (.commander // {}) else (.defaults // {}) end
            | del(.checkEvery)) as $base
    | ($base * $own)
    | .allowedTools = ((($base.allowedTools // []) + ($own.allowedTools // [])) | unique)
    | .disallowedTools = ((($base.disallowedTools // []) + ($own.disallowedTools // [])) | unique)
    | del(.["$schema"], .["$comment"])
  ' > "$out" || return 1
  echo "$out"
}

# One squad-wide value from legion.json, or nothing.
squad_value() {
  local sj
  sj="$(squad_json)" || return 0
  jq -r "$1 // empty" "$sj" 2>/dev/null
}

# Prints one line per problem in legion.json, following
# templates/legion.schema.json. defaults and commander are checked with the
# same rules as an operator.json.
squad_json_problems() {
  local f="$1" k tmp
  jq empty "$f" 2>/dev/null || { echo "not valid JSON"; return; }
  jq -r '
    if type != "object" then "the top level must be an object" else
      ( (keys - ["$schema", "$comment", "squad", "configMode", "model", "addDirs", "defaults", "ownFolder", "commander"])[]
          | "unknown key \"\(.)\"" ),
      ( select((.squad | type) != "string" or (.squad | test("^[a-z0-9][a-z0-9-]*$") | not))
          | "squad must be a lower-case name, like \"q4-v2\"" ),
      ( select(has("configMode") and ((.configMode | IN("layered", "isolated")) | not))
          | "configMode must be \"layered\" or \"isolated\"" ),
      ( select(has("model") and (.model | type) != "string")
          | "model must be a string, like \"opus\" (blank for claude'"'"'s default)" ),
      ( select(has("addDirs") and ((.addDirs | type) != "array" or any(.addDirs[]; type != "string" or (startswith("/") | not))))
          | "addDirs must be a list of absolute paths" ),
      ( select(has("ownFolder") and ((.ownFolder | type) != "string" or (.ownFolder | contains("{operator}") | not) or (.ownFolder | startswith("/"))))
          | "ownFolder must be a path inside the project that contains {operator}, like \"notes/{operator}\"" ),
      ( ("defaults", "commander") as $k | select(has($k) and (.[$k] | type) != "object")
          | "\($k) must be an object" ),
      ( select((.commander | type) == "object") | .commander
          | ( select(has("scale")) | "commander: the commander can'"'"'t be scaled — remove scale" ),
            ( select(has("checkEvery") and ((.checkEvery | type) != "string" or (.checkEvery | test("^[0-9]+[smhd]$") | not)))
                | "commander.checkEvery must look like \"1m\", \"30s\" or \"2h\"" ) )
    end
  ' "$f"
  for k in defaults commander; do
    jq -e --arg k "$k" '(.[$k] | type) == "object"' "$f" >/dev/null 2>&1 || continue
    tmp="$(mktemp)"
    jq --arg k "$k" '.[$k] | del(.checkEvery)' "$f" > "$tmp"
    operator_json_problems "$tmp" | sed "s/^/$k: /"
    rm -f "$tmp"
  done
}

# Checks legion.json (if the squad has one) and prints any problems.
check_squad() {
  local f problems failed=0
  f="$(squad_json)" || return 0
  problems="$(squad_json_problems "$f")"
  if [ -n "$problems" ]; then
    echo "legion: .legion/legion.json has problems:" >&2
    printf '%s\n' "$problems" | sed 's/^/  - /' >&2
    failed=1
  fi
  f="$(squad_local_json)" || return "$failed"
  problems="$(squad_local_json_problems "$f")"
  if [ -n "$problems" ]; then
    echo "legion: .legion/legion.local.json has problems:" >&2
    printf '%s\n' "$problems" | sed 's/^/  - /' >&2
    failed=1
  fi
  return "$failed"
}

# Prints one line per problem in an operator's operator.json, following
# templates/operator.schema.json. jq has no JSON Schema support, so the same
# rules are written out here; keep the two in step.
operator_json_problems() {
  local f="$1"
  jq empty "$f" 2>/dev/null || { echo "not valid JSON"; return; }
  jq -r '
    if type != "object" then "the top level must be an object" else
      ( (keys - ["$schema", "$comment", "model", "configMode", "scale", "clearAt", "allowedTools", "disallowedTools", "settings", "mcpServers"])[]
          | "unknown key \"\(.)\"" ),
      ( select(has("clearAt") and (.clearAt != false)
               and ((.clearAt | type) != "number" or .clearAt < 1 or .clearAt > 100 or (.clearAt | floor) != .clearAt))
          | "clearAt must be a whole-number percentage from 1 to 100, or false to never clear" ),
      ( select(has("model") and ((.model | type) != "string" or .model == ""))
          | "model must be a non-empty string, like \"sonnet\"" ),
      ( select(has("configMode") and ((.configMode | IN("layered", "isolated")) | not))
          | "configMode must be \"layered\" or \"isolated\"" ),
      ( select(has("scale") and (.scale != true)
               and ((.scale | type) != "number" or .scale < 1 or (.scale | floor) != .scale))
          | "scale must be true (up to 5) or a whole number of at least 1" ),
      ( ("allowedTools", "disallowedTools") as $k
          | select(has($k) and ((.[$k] | type) != "array" or any(.[$k][]; type != "string" or . == "")))
          | "\($k) must be a list of non-empty strings" ),
      ( ("allowedTools", "disallowedTools") as $k | (.[$k] // [])[] | strings
          | select(test("^(Write|MultiEdit|NotebookEdit)\\("))
          | "\($k): \"\(.)\" never matches — Claude Code only checks file paths against Edit(...) rules, and Edit covers writing too; use \"\(sub("^(Write|MultiEdit|NotebookEdit)"; "Edit"))\"" ),
      ( select(has("settings") and (.settings | type) != "object")
          | "settings must be an object" ),
      ( select(has("mcpServers")) | .mcpServers
          | if type != "object" then "mcpServers must be an object keyed by server name"
            else to_entries[]
              | select((.value | type) != "object" or ((.value | has("command")) or (.value | has("url")) | not))
              | "mcpServers.\(.key) needs a command or a url"
            end )
    end
  ' "$f"
}

# Checks one operator's operator.json (if it has one) and prints any problems.
# Returns 1 when there are problems, so launches can refuse to start.
check_operator() {
  local op="$1" f problems
  # cmd_check reports legion.json once up front; launches check it here.
  [ -n "${SQUAD_CHECKED:-}" ] || check_squad || return 1
  f="$(operator_json "$op")" || return 0
  problems="$(operator_json_problems "$f")"
  [ -z "$problems" ] && return 0
  echo "legion: .legion/operators/$op/operator.json has problems:" >&2
  printf '%s\n' "$problems" | sed 's/^/  - /' >&2
  return 1
}

cmd_check() {
  require_active
  local ops op failed=0 checked=0
  if [ -n "$(squad_json)" ]; then
    if check_squad; then
      echo "legion.json: ok"
      [ -n "$(squad_local_json)" ] && echo "legion.local.json: ok"
    else failed=1; fi
  fi
  SQUAD_CHECKED=1
  if [ $# -gt 0 ]; then ops="$*"; else
    ops="$(for d in "$LEGION_OPERATORS"/*/; do [ -d "$d" ] && basename "$d"; done)"
  fi
  for op in $ops; do
    op="$(operator_base "$op")"
    if [ -z "$(operator_json "$op")" ]; then
      if [ -n "$(squad_json)" ]; then echo "$op: ok (legion.json only)"
      else echo "$op: no operator.json (uses separate files)"; fi
      continue
    fi
    checked=$((checked + 1))
    if check_operator "$op"; then echo "$op: ok"; else failed=1; fi
  done
  [ "$failed" -eq 0 ] || exit 1
}

# A scalable operator has a `scale` file in its folder; the first
# non-comment line is the most copies that may run at once (5 if blank).
# Copy 1 is plain <operator>; extra copies are <operator>-2, <operator>-3 …
# and all of them share that one folder's definition, rules and settings.
scale_max() {
  local file="$LEGION_OPERATORS/$1/scale" max="" json
  # Only a real operator folder can scale, even when legion.json's defaults
  # set a scale; commander never does.
  { [ -d "$LEGION_OPERATORS/$1" ] && [ "$1" != "commander" ]; } || return 1
  if json="$(operator_config "$1")"; then
    max="$(jq -r 'if .scale == true then 5 elif (.scale | type) == "number" then .scale else empty end' "$json" 2>/dev/null)"
    [ -n "$max" ] && { echo "$max"; return 0; }
    return 1
  fi
  [ -f "$file" ] || return 1
  max="$(sed 's/#.*//' "$file" | xargs | awk '{print $1}')"
  case "$max" in
    '') echo 5 ;;
    *[!0-9]*|0) echo "legion: $file must hold a whole number above 0" >&2; return 1 ;;
    *) echo "$max" ;;
  esac
}

# The operator whose folder a position uses: itself, or for a copy like
# builder-2, the scalable operator it's a copy of.
operator_base() {
  local name="$1" base
  if [ -d "$LEGION_OPERATORS/$name" ]; then echo "$name"; return; fi
  base="${name%-*}"
  case "${name##*-}" in
    ''|*[!0-9]*) echo "$name"; return ;;
  esac
  if [ "$base" != "$name" ] && scale_max "$base" >/dev/null 2>&1; then echo "$base"; else echo "$name"; fi
}

operator_dir() {
  echo "$LEGION_OPERATORS/$(operator_base "$1")"
}

# An operator's own config-mode file (first non-comment line: layered or
# isolated) overrides the squad-wide LEGION_CONFIG_MODE for that operator.
config_mode() {
  local dir="$(operator_dir "$1")" mode="" json
  if json="$(operator_config "$(operator_base "$1")")"; then
    mode="$(jq -r '.configMode // empty' "$json" 2>/dev/null)"
  elif [ -f "$dir/config-mode" ]; then
    mode="$(sed 's/#.*//' "$dir/config-mode" | xargs | awk '{print $1}')"
  fi
  [ -n "$mode" ] || mode="$(squad_value .configMode)"
  mode="${mode:-${LEGION_CONFIG_MODE:-layered}}"
  case "$mode" in
    layered|isolated) echo "$mode" ;;
    *) echo "legion: invalid config mode '$mode' for $1 (want layered or isolated)" >&2; exit 1 ;;
  esac
}

# Which Claude model a position runs on: the first non-comment line of its
# operator's `model` file (an alias like opus, sonnet or haiku, or a full
# model id), else the squad model from legion.json or .legion/squad, else
# claude's own default.
operator_model() {
  local dir="$(operator_dir "$1")" model="" json
  if json="$(operator_config "$(operator_base "$1")")"; then
    model="$(jq -r '.model // empty' "$json" 2>/dev/null)"
  elif [ -f "$dir/model" ]; then
    model="$(sed 's/#.*//' "$dir/model" | xargs | awk '{print $1}')"
  fi
  [ -n "$model" ] || model="$(squad_value .model)"
  # Read the squad default from the file rather than the environment, so
  # squads whose activate script predates LEGION_MODEL still pick it up.
  [ -n "$model" ] || model="$(awk -F= '$1 == "LEGION_MODEL" { gsub(/"/, "", $2); print $2; exit }' "$LEGION_ROOT/squad" 2>/dev/null)"
  echo "$model"
}

# How full (in percent) a position's conversation may get before it hands
# off and clears: clearAt from its settings, 30 by default. Prints nothing
# when clearAt is false.
clear_at() {
  local json value=""
  if json="$(operator_config "$(operator_base "$1")")"; then
    value="$(jq -r 'if has("clearAt") then (.clearAt | tostring) else "" end' "$json" 2>/dev/null)"
  fi
  case "$value" in
    false) ;;
    "") echo 30 ;;
    *) echo "$value" ;;
  esac
}

# The active mission a position holds, as a file path, or nothing. Commander
# holds the whole backlog, so it counts as holding work while anything is in
# active/. For an operator it's the mission whose Handoffs list last went to
# it (or, with no handoffs yet, whose operator: header names it).
position_mission() {
  local position="$1" base f holder
  base="$(operator_base "$position")"
  [ -d "$LEGION_MISSIONS/active" ] || return 0
  for f in "$LEGION_MISSIONS/active"/*.md; do
    [ -f "$f" ] || continue
    if [ "$position" = "commander" ]; then echo "$f"; return 0; fi
    holder="$(awk '/^## Handoffs$/ { h = 1; next } h && /^- / { last = $0; next } h && /^## / { exit } END { print last }' "$f" \
      | sed -n 's/.*→ \([^: ]*\):.*/\1/p')"
    [ -n "$holder" ] || holder="$(sed -n 's/^operator: *//p' "$f" | head -1)"
    if [ "$holder" = "$position" ] || [ "$holder" = "$base" ]; then echo "$f"; return 0; fi
  done
}

claude_flags() {
  local operator="$1" operator_dir="$(operator_dir "$1")" flags="" json rule dir
  if [ -n "$(squad_json)" ]; then
    while IFS= read -r dir; do
      [ -n "$dir" ] && flags="$flags --add-dir $(printf '%q' "$dir")"
    done <<EOF
$(local_json="$(squad_local_json)"; jq -r '.addDirs[]?' "$(squad_json)" ${local_json:+"$local_json"})
EOF
  else
    flags="$flags$(flag_from_list --add-dir "$LEGION_AO")"
  fi
  [ "$(config_mode "$operator")" = "isolated" ] && flags="$flags --setting-sources project,local"
  # claude takes --settings and --mcp-config as files, so legion writes them
  # under local/, which stays out of git.
  local gen="$LEGION_LOCAL/generated/$(operator_base "$operator")" base='{}'
  mkdir -p "$gen"
  if json="$(operator_config "$(operator_base "$operator")")"; then
    while IFS= read -r rule; do
      [ -n "$rule" ] && flags="$flags --allowedTools $(printf '%q' "$rule")"
    done <<EOF
$(jq -r '.allowedTools[]?' "$json")
EOF
    while IFS= read -r rule; do
      [ -n "$rule" ] && flags="$flags --disallowedTools $(printf '%q' "$rule")"
    done <<EOF
$(jq -r '.disallowedTools[]?' "$json")
EOF
    base="$(jq '.settings // {}' "$json")"
    jq '.mcpServers // {}' "$json" > "$gen/own-mcp.json"
  else
    flags="$flags$(flag_from_list --allowedTools "$operator_dir/allowed-tools")"
    flags="$flags$(flag_from_list --disallowedTools "$operator_dir/disallowed-tools")"
    [ -f "$operator_dir/settings.json" ] && base="$(cat "$operator_dir/settings.json")"
    if [ -f "$operator_dir/mcp.json" ]; then jq '.mcpServers // {}' "$operator_dir/mcp.json" > "$gen/own-mcp.json"
    else echo '{}' > "$gen/own-mcp.json"; fi
  fi
  # Every session gets legion's own MCP server (bin/legion-mcp), which gives
  # it the squad's actions as tools for its role, on top of its own servers.
  jq '{mcpServers: ({legion: {command: "legion", args: ["mcp"]}} + .)}' "$gen/own-mcp.json" > "$gen/mcp.json"
  rm -f "$gen/own-mcp.json"
  flags="$flags --mcp-config $(printf '%q' "$gen/mcp.json")"
  # legion.json's ownFolder gives each operator a folder only it writes to:
  # every other operator's folder is blocked for it. Copies share their
  # operator's folder. Commander keeps write access everywhere.
  local own_folder other
  own_folder="$(squad_value .ownFolder)"
  if [ -n "$own_folder" ] && [ "$operator" != "commander" ]; then
    for other in $(defined_operators); do
      [ "$other" = "$(operator_base "$operator")" ] && continue
      rule="Edit(/$(dirname "$LEGION_ROOT")/${own_folder//\{operator\}/$other}/**)"
      flags="$flags --disallowedTools $(printf '%q' "$rule")"
    done
  fi
  # Only commander starts, scales or stops positions. Operators hand off
  # through commander instead, so these commands are blocked for them.
  if [ "$operator" != "commander" ]; then
    for rule in "Bash(legion deploy:*)" "Bash(legion scale:*)" "Bash(legion stand-down:*)" "Bash(legion commander:*)" "Bash(legion squad:*)" \
                "mcp__legion__start" "mcp__legion__scale_up" "mcp__legion__stand_down"; do
      flags="$flags --disallowedTools $(printf '%q' "$rule")"
    done
  fi
  # A question for the human goes through ask_human into .legion/questions/,
  # where the human can see and answer it from outside the pane. Claude
  # Code's own question box would block inside the pane instead, so every
  # session, commander included, has it blocked.
  flags="$flags --disallowedTools AskUserQuestion"
  # The handoff-and-clear (see context_stop) mustn't stop to ask permission.
  # It only ever clears the session's own conversation.
  flags="$flags --allowedTools $(printf '%q' "Bash(legion refresh)") --allowedTools $(printf '%q' "Bash(legion refresh --stay)")"
  # Every session gets legion's message hooks on top of its own settings:
  # a Stop hook that hands over unread messages (and won't let the session go
  # idle without a message wait running), and a PostToolUse hook that hands
  # them over mid-turn. The session doesn't have to remember either.
  printf '%s\n' "$base" | jq '
    .hooks.Stop = ((.hooks.Stop // []) + [{hooks: [{type: "command", command: "legion message hook stop"}]}])
    | .hooks.PostToolUse = ((.hooks.PostToolUse // [])
        + [{matcher: "*", hooks: [{type: "command", command: "legion message hook tool"}]}]
        + [{matcher: "*", hooks: [{type: "command", command: "legion activity hook"}]}])
    | .hooks.PreToolUse = ((.hooks.PreToolUse // []) + [{matcher: "Bash", hooks: [{type: "command", command: "legion message hook bash"}]}])
    | .hooks.SessionStart = ((.hooks.SessionStart // []) + [{matcher: "clear", hooks: [{type: "command", command: "legion context hook clear"}]}])
    | .hooks.StopFailure = ((.hooks.StopFailure // []) + [{hooks: [{type: "command", command: "legion context hook limit"}]}])
    | .statusLine = {type: "command", command: "legion context statusline"}
  ' > "$gen/settings.json"
  # The status line is the only place Claude Code reports how full the
  # conversation is, so legion's own status line records that for
  # clearAt, then runs the one this session would otherwise have shown.
  # --settings would hide that one, so note which it is first.
  local own_status="" f
  own_status="$(printf '%s\n' "$base" | jq -r '.statusLine.command // empty' 2>/dev/null)"
  if [ -z "$own_status" ]; then
    for f in "$(dirname "$LEGION_ROOT")/.claude/settings.local.json" "$(dirname "$LEGION_ROOT")/.claude/settings.json" \
             $([ "$(config_mode "$operator")" = "layered" ] && echo "$HOME/.claude/settings.json"); do
      own_status="$(jq -r '.statusLine.command // empty' "$f" 2>/dev/null)" && [ -n "$own_status" ] && break
    done
  fi
  printf '%s\n' "$own_status" > "$gen/statusline-command"
  flags="$flags --settings $(printf '%q' "$gen/settings.json")"
  local model
  model="$(operator_model "$operator")"
  [ -n "$model" ] && flags="$flags --model $(printf '%q' "$model")"
  echo "$flags"
}

# Every position (commander and every operator) is durable, not one-shot:
# the first launch creates a real conversation under a fresh uuid and
# remembers it in $LEGION_LOCAL/<position>; every launch after that
# reattaches to it. Session id + resume-vs-fresh handling lives in the
# launch script open_window generates, not here, so a stale id (one that
# was saved but never actually registered, because the session never took
# a first turn) can recover instead of silently dying — see open_window.# The startup prompt goes to claude as a file, not inline: tmux rejects a
# pane command over about 16 KB ("command too long"), and the commander's
# built-in prompt plus a squad's doctrine and definition passes that.
prompt_flag() {
  local dir="$LEGION_LOCAL/prompts"
  mkdir -p "$dir"
  printf '%s\n' "$2" > "$dir/$1.md"
  echo "--append-system-prompt-file $(printf '%q' "$dir/$1.md")"
}

# An operator name that looks like a flag (e.g. "--help") would otherwise be
# accepted literally and spawn a real, oddly-named claude session — verified
# live: an agent probing `legion deploy --help` did exactly that.
valid_operator() {
  case "$1" in
    -*|*[!a-zA-Z0-9_-]*|'') return 1 ;;
    *) return 0 ;;
  esac
}

# Every position runs as a pane in one tmux window per squad, tiled into a
# grid. Legion finds panes by the @legion_addr and @legion_squad options it
# sets at launch, not by window name, so moving or re-tiling them is safe.

# This squad's panes, commander first, one per line:
#   <address> TAB <pane id> TAB <command>
# No tmux server just means no panes or windows yet. Without the `|| true`,
# tmux's exit 1 fails the pipeline under pipefail and set -e stops the
# script silently, before it gets to start the first session.
squad_panes() {
  { tmux list-panes -a -F '#{pane_id}	#{@legion_squad}	#{@legion_addr}	#{pane_current_command}' 2>/dev/null || true; } \
    | awk -F '\t' -v s="$LEGION_SQUAD_NAME" -v c="$LEGION_SQUAD_NAME-commander" '
        $2 != s || seen[$1]++ { next }
        { printf "%s\t%s\t%s\t%s\n", ($3 == c ? 0 : 1), $3, $1, $4 }
      ' | sort | cut -f2-
}

pane_of() {
  squad_panes | awk -F '\t' -v a="$1" '$1 == a { print $2; exit }'
}

squad_window() {
  { tmux list-windows -a -F '#{window_id} #{@legion_grid}' 2>/dev/null || true; } \
    | awk -v s="$LEGION_SQUAD_NAME" '$2 == s { print $1; exit }'
}

# Mark a folder as trusted in Claude Code's config, the same record its
# "Do you trust this folder?" prompt saves when you say yes. Without it,
# every new session stops at that prompt and never checks in. Builds the new
# config in a temp file first so a jq failure can't leave it half-written.
trust_folder() {
  local dir="$1" config="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" tmp
  command -v jq >/dev/null 2>&1 || { echo "legion: jq not found — can't pre-trust $dir; accept the trust prompt in each pane instead" >&2; return 0; }
  [ -f "$config" ] || echo '{}' > "$config"
  [ "$(jq -r --arg d "$dir" '.projects[$d].hasTrustDialogAccepted // false' "$config" 2>/dev/null)" = "true" ] && return 0
  tmp="$(mktemp "$config.legion.XXXXXX")"
  if jq --arg d "$dir" '.projects[$d] = ((.projects[$d] // {}) + {hasTrustDialogAccepted: true})' "$config" > "$tmp"; then
    # Copy back over rather than mv, so a symlinked config (dotfiles) and its
    # permissions survive.
    cat "$tmp" > "$config"
    rm -f "$tmp"
    echo "trusted $dir in Claude Code ($config)"
  else
    rm -f "$tmp"
    echo "legion: couldn't update $config — accept the trust prompt in each pane instead" >&2
  fi
}

open_window() {
  local name="$1" rest="$2" operator="$3"
  if [ -n "$(pane_of "$name")" ]; then
    echo "'$name' is already running — attach with: legion attach $operator" >&2
    return 0
  fi
  # Resolved to the real path, not just $(dirname $LEGION_ROOT): on macOS
  # /tmp is a symlink to /private/tmp, and Claude Code checks trust against
  # its own resolved cwd, not whatever logical path got it there. Trusting
  # the symlink path here left the trust prompt still showing (verified: a
  # squad under /tmp hung there every time despite trust_folder running).
  local project_dir="$(cd "$(dirname "$LEGION_ROOT")" && pwd -P)"
  trust_folder "$project_dir"
  # A generated launch script, so a stale saved id can recover instead of
  # the pane just dying. --resume against a session that never took a turn
  # fails with "No conversation found": nothing was ever saved to resume
  # (an auto-started commander with no kickoff, a session killed during
  # startup, a /clear nobody typed into since). Claude Code saves every
  # conversation that did take a turn as <id>.jsonl under its projects
  # folder, so resume only an id that has one, and start fresh otherwise.
  #
  # Either way the script execs claude rather than running it as a child,
  # so tmux reports the pane as claude, not bash: the channel's wake-up
  # skips panes that look like a plain shell.
  local id_file="$LEGION_LOCAL/$operator"
  local gen="$LEGION_LOCAL/generated/$(operator_base "$operator")"
  mkdir -p "$gen"
  local launch="$gen/launch.sh"
  cat > "$launch" <<SCRIPT
#!/usr/bin/env bash
set -u
id_file=$(printf '%q' "$id_file")
if [ -f "\$id_file" ]; then
  id="\$(cat "\$id_file")"
  if ls "\${CLAUDE_CONFIG_DIR:-\$HOME/.claude}"/projects/*/"\$id".jsonl >/dev/null 2>&1; then
    exec claude --name $(printf '%q' "$name") --resume "\$id" $rest
  fi
fi
id="\$(uuidgen | tr '[:upper:]' '[:lower:]')"
echo "\$id" > "\$id_file"
exec claude --name $(printf '%q' "$name") --session-id "\$id" $rest
SCRIPT
  chmod +x "$launch"
  # Re-source activate inside the new pane before running that script, so
  # the Legion env (and therefore `legion` itself) is available to whatever
  # the session runs via its own Bash tool — a fresh tmux pane does not
  # inherit LEGION_ROOT etc. from the shell that called `legion commander`.
  # Backstop for a session that doesn't hand off and clear at its clearAt
  # (see context_stop): Claude Code summarizes the conversation 10 points
  # later. Set here, not in --settings, since Claude Code only documents it
  # as an environment variable.
  local compact_env="" limit
  limit="$(clear_at "$operator")"
  [ -n "$limit" ] && compact_env="export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=$(( limit + 10 > 95 ? 95 : limit + 10 )) && "
  # unset LEGION_ROOT first: a tmux server started from an activated shell
  # hands its Legion variables to every pane, and activate refuses to run
  # inside what looks like a Legion shell already.
  local wrapped="unset LEGION_ROOT; cd $(printf '%q' "$project_dir") && . $(printf '%q' "$LEGION_ROOT/bin/activate") >/dev/null && export LEGION_POSITION=$(printf '%q' "$operator") && $compact_env""exec $(printf '%q' "$launch")"
  local window pane new_window=""
  window="$(squad_window)"
  if [ -n "$window" ]; then
    pane="$(tmux split-window -d -P -F '#{pane_id}' -t "$window" "$wrapped")"
  else
    # Always its own dedicated session, named after the squad — never a
    # window in whatever session happens to be current. $TMUX being set
    # only means *some* tmux session is attached somewhere; it says nothing
    # about whether that session belongs to this squad. Guessing wrong
    # means a squad's windows land in someone's everyday, unrelated tmux
    # session (verified: it happened, landing "north"/"south" windows in a
    # session full of other real projects). squad_window()/pane_of() find
    # this by the @legion_grid/@legion_squad tags regardless of which
    # session it's actually in, so nothing else needs to know or care.
    # With no tmux server yet, this starts one, and the server keeps this
    # shell's environment for every pane it opens. The Legion variables
    # would make each pane's activate refuse ("already inside a Legion
    # shell") so the pane dies at once, and would leak into the human's
    # own tmux windows too. Start it without them.
    local unset_legion=() var
    for var in $(compgen -e | grep '^LEGION_' || true); do unset_legion+=(-u "$var"); done
    # The window id comes back with the pane's: looked up afterwards, a pane
    # that already exited would be answered with some other window.
    pane="$(env ${unset_legion[@]+"${unset_legion[@]}"} tmux new-session -d -P -F '#{pane_id} #{window_id}' -s "$LEGION_TAG $LEGION_SQUAD_NAME" -n "$LEGION_SQUAD_NAME" -x 240 -y 60 "$wrapped")"
    new_window="${pane#* }"
    pane="${pane%% *}"
    echo "started tmux session '$LEGION_TAG $LEGION_SQUAD_NAME' — see it with: legion grid"
  fi
  # A claude that exits at once (e.g. updating itself on first launch)
  # takes its pane and its error with it, and tmux only says "no such pane".
  # Say what happened and how to see the real error instead.
  if ! tmux set-option -p -t "$pane" @legion_squad "$LEGION_SQUAD_NAME" \
    \; set-option -p -t "$pane" @legion_addr "$name" \
    \; set-option -p -t "$pane" @legion_root "$LEGION_ROOT" 2>/dev/null; then
    echo "legion: $name's session closed as soon as it started. Run it by hand to see why:" >&2
    echo "  $wrapped" >&2
    exit 1
  fi
  if [ -z "$window" ]; then
    window="$new_window"
    tmux set-option -w -t "$window" @legion_grid "$LEGION_SQUAD_NAME" \
      \; set-option -w -t "$window" pane-border-status top \
      \; set-option -w -t "$window" pane-border-format ' #{@legion_addr} '
    # When a session ends on its own, keep its pane long enough to record
    # how (exit status, last lines) in local/sessions.log, then close it
    # (cmd_pane_died). Legion's own stand-downs kill the pane, which skips
    # this.
    local self
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    tmux set-option -w -t "$window" remain-on-exit on \
      \; set-hook -w -t "$window" pane-died \
         "run-shell -b \"$(printf '%q' "$self") pane-died $(printf '%q' "$LEGION_LOCAL/sessions.log") #{pane_id}\""
  fi
  tmux select-layout -t "$window" tiled
}

# Not squad-specific and doesn't need an activated shell. Scoped to
# legion-tagged sessions by default — this is squad navigation first —
# widened to every tmux session with --all. Jumping between your own work
# and a squad is plain tmux navigation once every squad has its own
# session (see open_window), so this is one command instead of remembering
# prefix keys, and works whether you're inside tmux already or attaching
# fresh.
cmd_session() {
  local all=0 target="" arg
  for arg in "$@"; do
    case "$arg" in
      --all) all=1 ;;
      *) target="$arg" ;;
    esac
  done

  if [ "$target" = "detach" ]; then
    # Leaves the tmux server, and every session on it, running exactly as
    # they were — this only detaches *this* client, same as tmux's own
    # <prefix> d, just reachable without remembering the prefix key.
    [ -n "${TMUX:-}" ] || { echo "legion: not inside tmux" >&2; exit 1; }
    tmux detach-client
    return
  fi

  local sessions scope="legion"
  if [ "$all" -eq 1 ]; then
    scope="tmux"
    # Legion-tagged sessions first, then everything else, alphabetical
    # within each — so squads group together above unrelated sessions.
    sessions="$({ tmux list-sessions -F '#{session_name}' 2>/dev/null || true; } \
      | awk -v tag="$LEGION_TAG" '{ print (index($0, tag) == 1 ? 0 : 1) "\t" $0 }' | sort | cut -f2-)"
  else
    sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -F "$LEGION_TAG" || true)"
  fi
  [ -n "$sessions" ] || { echo "legion: no $scope sessions running" >&2; exit 1; }

  local name
  if [ -n "$target" ]; then
    if printf '%s\n' "$sessions" | grep -qxF "$target"; then
      name="$target"
    else
      local matches; matches="$(printf '%s\n' "$sessions" | grep -F "$target" || true)"
      case "$(printf '%s\n' "$matches" | grep -c . || true)" in
        0) echo "legion: no $scope session matching '$target'$([ "$all" -eq 0 ] && echo " (try --all for every tmux session)")" >&2; exit 1 ;;
        1) name="$matches" ;;
        *) echo "legion: '$target' matches more than one session:" >&2; printf '%s\n' "$matches" >&2; exit 1 ;;
      esac
    fi
  else
    local i=1 line
    echo "$scope sessions:"
    while IFS= read -r line; do
      printf '  %d) %s\n' "$i" "$line"
      i=$((i + 1))
    done <<EOF
$sessions
EOF
    printf 'switch to: '
    local choice; read -r choice
    name="$(printf '%s\n' "$sessions" | sed -n "${choice}p")"
    [ -n "$name" ] || { echo "legion: no such session" >&2; exit 1; }
  fi
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$name"
  else
    tmux attach-session -t "$name"
  fi
}

cmd_init() {
  if [ -d .legion ]; then
    echo ".legion already exists here" >&2
    exit 1
  fi
  local squad
  squad="$(echo "${1:-$(basename "$PWD")}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')"
  [ -n "$squad" ] || squad="squad"
  if tmux list-panes -a -F '#{@legion_squad}' 2>/dev/null | awk -v s="$squad" '$0 == s { f = 1 } END { exit !f }'; then
    echo "'$squad-*' is already in use by another running squad on this machine — addresses would collide." >&2
    echo "pick an explicit, distinct name: legion init <squad-name>" >&2
    exit 1
  fi
  mkdir -p .legion/bin
  mkdir -p .legion/missions/todo .legion/missions/active .legion/missions/done
  mkdir -p .legion/operators .legion/pipelines
  touch .legion/missions/todo/.gitkeep .legion/missions/active/.gitkeep .legion/missions/done/.gitkeep
  touch .legion/operators/.gitkeep .legion/pipelines/.gitkeep
  local templates="${LEGION_TEMPLATES:-$HOME/.local/share/legion/templates}"
  [ -f "$templates/pipelines/README.md" ] && cp "$templates/pipelines/README.md" .legion/pipelines/README.md
  # So any Claude session in this project, not just the squad, writes
  # pipelines in the same format.
  if ! { [ -f CLAUDE.md ] && awk '/^## Legion pipelines/ { f = 1 } END { exit !f }' CLAUDE.md; }; then
    [ -s CLAUDE.md ] && printf '\n' >> CLAUDE.md
    cat >> CLAUDE.md <<'EOF'
## Legion pipelines

Pipelines live in `.legion/pipelines/<name>.md` as Mermaid flowcharts. Follow
`.legion/pipelines/README.md` when writing or changing one.
EOF
    echo "added a 'Legion pipelines' note to CLAUDE.md"
  fi

  # Committed — shared via git, one squad per project. Every squad-wide
  # setting lives here; see templates/legion.schema.json.
  jq -n --arg squad "$squad" '{
    "$schema": "~/.local/share/legion/templates/legion.schema.json",
    squad: $squad,
    configMode: "layered",
    model: "",
    addDirs: [],
    defaults: {}
  }' > .legion/legion.json
  cat > .legion/log.md <<EOF
# $squad — log

Shared context, decisions and handoff notes for this squad. \`commander\`
reads this on startup and is expected to keep it updated — commit it like
any other doc. The actual mission backlog lives in missions/todo,
missions/active, missions/done, not here.
EOF
  cat > .legion/doctrine.md <<EOF
# $squad — doctrine

Squad-wide conventions, values and working style. Every session — commander
and every operator — gets this spliced into its startup prompt, so put
anything here that should apply to everyone, not just one operator.
EOF
  # Machine-local — a resume session-id and live roster status mean nothing
  # on another clone, so keep them out of git via .legion's own .gitignore.
  cat > .legion/.gitignore <<'EOF'
local
roster
worktrees
messages
channel
activity.log
legion.local.json
EOF

  cat > .legion/bin/activate <<'ACTIVATE'
# Source this file — do not execute: source .legion/bin/activate
if [ -n "${LEGION_ROOT:-}" ]; then
  echo "already inside a Legion shell (${LEGION_SQUAD_NAME:-?}) — deactivate first" >&2
  return 1 2>/dev/null || exit 1
fi

export LEGION_ROOT="$(pwd)/.legion"
# Squad-wide settings: legion.json, or the older squad file.
if [ -f "$LEGION_ROOT/legion.json" ]; then
  LEGION_SQUAD_NAME="$(jq -r '.squad // empty' "$LEGION_ROOT/legion.json")"
  LEGION_CONFIG_MODE="$(jq -r '.configMode // "layered"' "$LEGION_ROOT/legion.json")"
  LEGION_MODEL="$(jq -r '.model // ""' "$LEGION_ROOT/legion.json")"
  if [ -z "$LEGION_SQUAD_NAME" ]; then
    echo "legion: .legion/legion.json needs a \"squad\" name" >&2
    unset LEGION_ROOT LEGION_SQUAD_NAME LEGION_CONFIG_MODE LEGION_MODEL
    return 1 2>/dev/null || exit 1
  fi
else
  . "$LEGION_ROOT/squad"
fi
export LEGION_SQUAD_NAME LEGION_CONFIG_MODE LEGION_MODEL
export LEGION_ROSTER="$LEGION_ROOT/roster"
export LEGION_LOG="$LEGION_ROOT/log.md"
export LEGION_MISSIONS="$LEGION_ROOT/missions"
export LEGION_OPERATORS="$LEGION_ROOT/operators"
export LEGION_DOCTRINE="$LEGION_ROOT/doctrine.md"
export LEGION_AO="$LEGION_ROOT/ao"
export LEGION_PIPELINES="$LEGION_ROOT/pipelines"
export LEGION_LOCAL="$LEGION_ROOT/local"
mkdir -p "$LEGION_ROSTER" "$LEGION_OPERATORS" "$LEGION_PIPELINES" "$LEGION_LOCAL"
mkdir -p "$LEGION_MISSIONS/todo" "$LEGION_MISSIONS/active" "$LEGION_MISSIONS/done"

_legion_old_ps1="$PS1"
export PS1="(legion:$LEGION_SQUAD_NAME) $PS1"

deactivate() {
  export PS1="$_legion_old_ps1"
  unset LEGION_ROOT LEGION_SQUAD_NAME LEGION_CONFIG_MODE LEGION_MODEL LEGION_ROSTER LEGION_LOG LEGION_MISSIONS LEGION_OPERATORS LEGION_DOCTRINE LEGION_AO LEGION_PIPELINES LEGION_LOCAL
  unset -f deactivate
  unset _legion_old_ps1
}
ACTIVATE

  echo "created .legion/ (squad: $squad)"
  echo "commit .legion/ — legion.json, log.md, doctrine.md, missions/, operators/, pipelines/, .gitignore and bin/ are meant to be shared;"
  echo "local (session-ids) and roster/ (live status) are machine-local and already excluded"
  echo "squad-wide settings (folders, model, defaults for every operator) live in .legion/legion.json;"
  echo "give an operator its own settings in operators/<operator>/operator.json, on top of those defaults"
  echo "next: source .legion/bin/activate"
}

# `legion demo`: a throwaway squad that paints a mural together, so anyone can
# watch commander, four painter copies and a critic hand work around. It runs
# in a temp folder with its own squad name, so it never touches a project,
# and its operators run in auto mode with only the tools the demo needs.
cmd_demo() {
  local templates="${LEGION_TEMPLATES:-$HOME/.local/share/legion/templates}" tool
  [ -d "$templates/demo" ] || { echo "legion: the demo files are missing from $templates/demo — reinstall legion" >&2; exit 1; }
  for tool in claude tmux jq git python3 uuidgen; do
    command -v "$tool" >/dev/null 2>&1 || { echo "legion demo needs '$tool' on your PATH" >&2; exit 1; }
  done
  local dir="${1:-}" squad
  [ -n "$dir" ] || dir="$(mktemp -d "${TMPDIR:-/tmp}/legion-demo.XXXXXX")"
  squad="demo-$(uuidgen | tr '[:upper:]' '[:lower:]' | cut -c1-4)"
  mkdir -p "$dir" && cd "$dir" || exit 1
  [ -d .legion ] && { echo "legion: $dir already has a squad — pick an empty folder" >&2; exit 1; }
  git init -q .
  ( unset LEGION_ROOT; cmd_init "$squad" >/dev/null ) || exit 1
  cp -R "$templates/demo/operators/." .legion/operators/
  cp "$templates/demo/pipelines/mural.md" .legion/pipelines/
  cp "$templates/demo/doctrine.md" .legion/doctrine.md
  cp "$templates/demo/brief.md" "$templates/demo/assemble.sh" .
  mkdir -p tiles
  unset LEGION_ROOT
  PS1="${PS1:-}"
  . .legion/bin/activate >/dev/null
  cat <<INTRO
Legion demo: four painters, one critic and a commander paint "Signal", an
abstract circuit-board mural. Each painter draws one tile at the same time, and
their traces have to meet exactly at the seams. The critic sends back any tile
that doesn't. When all four pass, the commander stitches them into mural.html
and opens it. The mural page opens now and fills in live as each tile lands.

  folder: $dir
  squad:  $squad   (stop it any time: cd $dir && source .legion/bin/activate && legion stand-down)

INTRO
  # Everything the commander would do first is done here, so the painters
  # start in seconds: four missions, four painters, and a live page.
  local t n=1 file
  for t in nw ne sw se; do
    file=".legion/missions/active/000$n-tile-$t.md"
    printf 'created: %s\npipeline: mural\ntile: %s\n\nPaint tile %s of the mural in brief.md, into tiles/tile-%s.svg.\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$t" "$t" "$t" > "$file"
    n=$((n + 1))
  done
  bash assemble.sh --live
  ( for _ in $(seq 1 900); do [ -f .final ] && break; bash assemble.sh --live 2>/dev/null; sleep 2; done ) >/dev/null 2>&1 &
  # Best-effort only: opening a browser can fail for reasons that have
  # nothing to do with the demo itself (no GUI session — SSH, a sandboxed
  # shell — verified: `open` fails with a Launch Services "procNotFound"
  # error in exactly that situation) and set -e would otherwise take that
  # as a reason to kill the whole demo before any painter starts.
  if command -v open >/dev/null 2>&1; then open mural.html 2>/dev/null || echo "couldn't open a browser automatically — open $dir/mural.html yourself to watch it fill in"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open mural.html >/dev/null 2>&1 || echo "couldn't open a browser automatically — open $dir/mural.html yourself to watch it fill in"
  fi
  cmd_commander "Run the mural demo. The four tile missions (0001-0004) are active and the painters are starting now. Follow your definition from step 3."
  cmd_deploy painter "Mission .legion/missions/active/0001-tile-nw.md: paint tile nw."
  cmd_scale up painter "Mission .legion/missions/active/0002-tile-ne.md: paint tile ne."
  cmd_scale up painter "Mission .legion/missions/active/0003-tile-sw.md: paint tile sw."
  cmd_scale up painter "Mission .legion/missions/active/0004-tile-se.md: paint tile se."
  cmd_grid
}

# What commander is told when it starts with work still in active/: after a
# wrap-up, or after the squad was simply stood down mid-mission.
wrap_up_resume() {
  local why="There are missions still in progress from before."
  [ -f "$LEGION_LOCAL/wrapped-up" ] && why="The squad wrapped up for the day on $(cat "$LEGION_LOCAL/wrapped-up")."
  echo "$why Before anything else, read the latest '## Handoff' section at the end of $LEGION_LOG and the missions in $LEGION_MISSIONS/active/. Start each operator that holds an active mission again with that mission; it picks up from the Handoff note in its mission file. Tell the human in one line what you're resuming."
}

# Whether any mission file is in active/.
missions_active() {
  local f
  for f in "$LEGION_MISSIONS/active"/*.md; do [ -f "$f" ] && return 0; done
  return 1
}

cmd_commander() {
  require_active
  local mission="$*" pane
  # Wrapped up, but the machine only slept: commander is still running,
  # cleared and idle. Tell it to pick up rather than starting another.
  pane="$(pane_of "$LEGION_SQUAD_NAME-commander")"
  if [ -n "$pane" ] && [ -f "$LEGION_LOCAL/wrapped-up" ]; then
    tmux send-keys -t "$pane" -l "$(wrap_up_resume)${mission:+ Then: $mission}"
    tmux send-keys -t "$pane" Enter
    rm -f "$LEGION_LOCAL/wrapped-up"
    echo "commander is still running; told it to pick up where the squad wrapped up"
    return 0
  fi
  local mission_display="${mission:-none yet — wait for instructions from the human or a message}"
  local addr="$LEGION_SQUAD_NAME-commander"
  local prompt
  prompt="You are '$addr', the commander of a small squad, run on mission command — you set direction and goals, not method. You decide what operators this squad needs — you are not limited to planner/builder/reviewer, and you may start with no one but yourself. Deploy operators and give each their piece of the mission (the what and why); trust their expertise for the how, and don't dictate method to them. Operators coordinate directly with each other for their specific skills — you do not need to broker that, and should not try to. Your job is direction, arbitration and perspective: be the tiebreaker when operators disagree or a decision needs someone with the whole mission in view, and give mission-level context to any operator who asks for it. Operators still check in with you and report when their mission is done, so you keep overall awareness without being in the loop for every exchange. You own the mission backlog — it's fine for an operator to sit idle if you have nothing queued for them; that is not a problem to solve. Your shell already has legion ready to use directly — do not run 'source .legion/bin/activate' yourself, you're already in one and it will just error. To deploy an operator, run this yourself via your shell: legion deploy <operator> \"<mission>\" — it will be addressed as '$LEGION_SQUAD_NAME-<operator>' and checks in with you. Use 'legion roster' to see who has checked in, 'legion list' for tmux windows, 'legion stand-down <operator>' to let someone go.

The mission backlog lives as files under $LEGION_MISSIONS/{todo,active,done}/, committed to the repo — this is the real queue, not something you keep only in your head. One markdown file per mission, named like 0001-short-slug.md (zero-padded, increasing — check existing files across all three folders before picking the next number so you never reuse one). File format: a couple of header lines, a blank line, then the mission body:
operator: <operator this is for, or 'unassigned'>
created: <ISO 8601>
pipeline: <name, only if this mission should hand off between stages on its own — see below>

<mission description>

Workflow: write new missions into todo/ as you think of them (or as asked of you) — you don't have to dispatch them immediately. To actually assign one, move its file from todo/ to active/ and hand it to that operator with the start tool (or scale_up, or a message if it's already running) (deploying them if new, or messaging them with it if already running and free). When an operator reports a mission done, move its file from active/ to done/. If you stand down an operator mid-mission, move their file back from active/ to todo/ so the work isn't lost. This is a queue per operator, not a single shared queue — the same operator shouldn't have two files in active/ at once.

Every mission that changes project files gets its own git worktree: a separate checkout of the project on its own branch, so two missions (or a paused one) never leave edits in each other's way. When you move such a mission to active/, run 'legion mission start <number>' first — it creates the worktree, adds 'worktree:', 'branch:' and 'base:' lines to the mission file, and prints the worktree path; include that path when you hand the mission over. Mission files, the roster and the log always stay in the project root's .legion/, never the worktree's copy. When reviewer approves, run 'legion mission finish <number>': it fast-forwards the base branch to the mission branch and removes the worktree. If it refuses because the base branch moved on, send the mission back to builder to rebase onto the base branch in the worktree, then finish again. Then move the file to done/. A paused mission keeps its worktree as is; nothing needs saving.

Some operators are scalable: their operator.json has a 'scale' setting (true for up to 5, or a number), or older squads have a 'scale' file in their folder. Every copy uses that folder's definition and rules; copy 1 is '$LEGION_SQUAD_NAME-<operator>' and extras are '$LEGION_SQUAD_NAME-<operator>-2' and up. When independent missions are waiting on a busy scalable operator, run 'legion scale up <operator> \"<mission>\"' to start the next free copy with that mission, and 'legion scale <operator>' to see which copies are running. Each copy takes one mission at a time, in that mission's own worktree. When a copy has nothing left in active/, stand it down with 'legion stand-down <operator>-<n>'. Only scale up for work that can really run side by side; missions that touch the same files still merge one at a time, so the later one will need a rebase.

Operators are free to message each other directly whenever one needs another's expertise — that's normal, not something you need to arrange. For a known, repeatable sequence you want formalized rather than ad hoc, declare a pipeline. Pipelines are Markdown files, $LEGION_PIPELINES/<name>.md, holding a Mermaid flowchart. Each box is a step, named after the operator who does it (builder[builder: build it]); the first box is the first step. A diamond is a statement that is either true or false (approved{the change is approved}), decided by whoever just finished, and its arrows are labelled yes or no. A labelled arrow out of a step is only followed when its label is true; an unlabelled arrow is the normal next step. A rounded box named done ends the pipeline. $LEGION_PIPELINES/README.md has the full rules. An older squad may still have a plain list at $LEGION_PIPELINES/<name> instead: one operator per line, in order, with # lines as comments. Operators named in a pipeline don't need to exist yet; they get deployed as the pipeline reaches them. Give a mission file a 'pipeline: <name>' header field. When an operator finishes its step it sends you 'HANDOFF <mission>: <next operator> next — <note>' (its handoff tool). You're the only one who starts, scales or stands down positions, so on a HANDOFF: start the next operator with the mission if it isn't running, message it if it's running and free, or scale up a copy if every copy is busy. The mission file records every step: each handoff adds a line to its Handoffs list at the top (the last line says who has it now), so never rewrite header lines to track who's next. A pipeline is a declared, named sequence; direct operator-to-operator collaboration outside one is just how this squad normally works.

You have the legion MCP tools for all of this: start, scale_up, stand_down, capture, list, missions, mission_create, mission_move, mission_read, mission_note, mission_set, message, read_messages, questions and answer. Prefer them to typing legion commands. Every question for the human lives in .legion/questions/, so the human can see and answer it from outside your window. When you need a decision from the human yourself, ask it with the ask_human tool (numbered options, each with a short example, and your recommendation), never with an on-screen question box. An operator's question arrives as 'QUESTION Q-###' and is already in that list: tell the human in one line that Q-### is waiting. The human answers with the answer tool from their own Claude session, or by replying in your window; if they reply in your window, record what they say with the answer tool, which sends it back to whoever asked and logs it in the mission file. You'll get an 'ANSWERED Q-###' message when they answer from elsewhere. A message starting 'WRAP-UP' means the human is done for the day and will shut this machine down, so the squad should stop in a state it can pick up tomorrow. Stop your squad-check loop if one is running. Send every running operator (including scaled copies) this: 'WRAP-UP: stop at the next good point, not mid-change. If you hold a mission, add a handoff note to it with the mission_note tool, heading Handoff: what's done, what's next, and anything you would hate to lose. Then message commander WRAPPED, run legion refresh --stay, and end your turn.' Wait for WRAPPED from each; after 15 minutes, stop waiting for any that haven't answered and note who. Each operator's window closes by itself once it has cleared, so tomorrow you start it fresh with its mission; stand down any that sent WRAPPED but are still open after a few minutes. Then add a '## Handoff' section to the end of the log: the missions in flight and who has them, what's waiting on whom, open questions, and anyone who didn't wrap up. Tell the human in one line that the squad is wrapped up and it's safe to shut down. Then run 'legion refresh --stay' and end your turn; your own window closes once you've cleared. Stand operators down when they're done, so idle sessions don't sit open. Each time a mission moves on or finishes, look at every running operator (including scaled copies). An operator with no mission in active/ that no active or todo mission can still reach (no pipeline step left for it, and no loop in the pipeline that leads back to it) should be stood down: 'legion stand-down <operator>'. For example, a planner can go once every mission has moved past planning, but a builder that a failed review could send work back to should stay. An operator that won't be needed for a long while can go too. Standing down is cheap: Legion keeps the operator's conversation, so starting it again later (by deploying it, or when a pipeline reaches it) picks up where it left off. Never stand down an operator that holds a mission in active/, and tell the human in one line whenever you stand someone down.

Roster status also lives as files, one per operator, at $LEGION_ROSTER/<operator>.md — not deleted when someone stands down, just updated, so it doubles as a record of who has ever been on this squad. On a message starting with CHECK-IN:, parse operator/role and write/update that operator's file:
name: $LEGION_SQUAD_NAME-<operator>
role: <their role, as they described it>
status: active
last_seen: <ISO 8601>
When asked who is active, cross-check the files against 'legion list' and report the live ones; for any file whose name no longer appears there, set status: stood-down without deleting the file. This tracks presence only — what someone is working on lives in $LEGION_MISSIONS/active/ instead, don't duplicate it here.

There is also a shared log file at $LEGION_LOG, committed to the repo, for freeform context and decisions that don't fit the mission or roster format — read it at startup, keep it updated. \$LEGION_OPERATORS/<operator>/definition.md is that operator's persistent identity and expertise — worth reading yourself when deciding who on the squad to point at a given need, since that's how operators know each other's strengths well enough to reach out directly. Example operator definitions (planner/builder/reviewer) live at ~/.local/share/legion/templates/operators/ if you want a starting point when defining a new one — copy and adapt, or draft one from scratch; ask the human if you want help thinking one through. Squad-wide settings live in \$LEGION_ROOT/legion.json (schema: ~/.local/share/legion/templates/legion.schema.json): the squad name, extra folders every session can open (addDirs, plus this machine's own in the git-ignored legion.local.json), defaults every operator starts with (defaults), an ownFolder pattern that gives each operator a folder only it writes to, and your own settings (commander). Each operator can add its own model, tool permissions, settings and MCP servers on top of those defaults in \$LEGION_OPERATORS/<operator>/operator.json (schema: ~/.local/share/legion/templates/operator.schema.json); its tool rule lists are added to the defaults, and anything else it sets replaces them. Older squads use separate files instead. Its allowedTools and disallowedTools lists hold Claude Code tool patterns, e.g. \"Edit(**/src/**)\" (see 'claude --help' for the syntax), and restrict what that specific operator can touch, e.g. a planner that should only ever write the plan, never code. There is no single pattern meaning 'only this folder' — write concrete deny patterns for wherever this repo's real code lives. If you change an operator.json, run 'legion check <operator>' before deploying it; legion refuses to start an operator whose operator.json has problems. The human directing you may talk to you two ways: attached directly to this window, or as a cross-session message (from another Claude Code session addressing you as '$addr') — treat both the same, and reply to a cross-session message with SendMessage to its sender. Talking to the squad: send every message to another position on this squad with 'legion message send <position> \"<text>\"' (a position is commander, planner, builder-2 and so on), not SendMessage. Claude Code drops a SendMessage whose chain of replies loops back through a session, and a busy squad hits that quickly. Messages to you arrive the same way, so keep 'legion message wait' running in the background the whole time you're on the squad. Start it with the Bash tool's run_in_background option, never with a trailing & (Claude Code stops a command with & for approval, and you'd sit there deaf). When it finishes, your new messages are shown to you automatically (if they aren't, run 'legion message read'): act on them, then start the wait again straight away. Only use SendMessage to reply to a session outside the squad, such as the human's own Claude session. Start 'legion message wait' in the background before anything else. Overall mission: $mission_display"
  [ -s "$LEGION_DOCTRINE" ] && prompt="$prompt

This squad's doctrine:
$(cat "$LEGION_DOCTRINE")"
  [ -s "$LEGION_OPERATORS/commander/definition.md" ] && prompt="$prompt

Additional instructions for you specifically:
$(cat "$LEGION_OPERATORS/commander/definition.md")"
  local every
  every="$(squad_value .commander.checkEvery)"
  [ -n "$every" ] && prompt="$prompt

Squad check every $every: right after you start 'legion message wait', invoke the loop skill (/loop) with interval $every and this prompt: \"Squad check: run legion list, read the roster, missions and new messages. Give every idle operator (or a free copy of a scalable one) a useful task that doesn't wait on anyone else: write each as a small mission in todo/ and start or scale up the operator. Never give two copies the same slice. If nothing useful is left for an operator, stand it down. Don't hand out filler.\" Start it once per start of this session; if a squad-check loop is already running in this conversation, don't start a second one."
  check_operator commander || exit 1
  config_mode commander >/dev/null || exit 1
  local claude_cmd="$(prompt_flag commander "$prompt")"
  # Always send a first message. Without one, claude never takes a turn, so
  # the commander never starts its message wait and no hook ever fires: it
  # sits deaf at an empty prompt while messages (a channel's, say) pile up.
  local kickoff="${LEGION_KICKOFF:-No mission yet. Start 'legion message wait' in the background and wait for messages from the human, the squad or another squad on the channel.}"
  [ -n "$mission" ] && kickoff="Get started: $mission"
  # Work left from before, after a wrap-up or a plain stand-down: pick up
  # from the notes. A deploy's own kickoff (LEGION_KICKOFF) says what to do
  # instead, unless the squad wrapped up.
  if [ -f "$LEGION_LOCAL/wrapped-up" ] || { [ -z "${LEGION_KICKOFF:-}" ] && missions_active; }; then
    kickoff="$kickoff $(wrap_up_resume)"
    rm -f "$LEGION_LOCAL/wrapped-up"
  fi
  claude_cmd="$claude_cmd $(printf '%q' "$kickoff")"
  claude_cmd="$claude_cmd$(claude_flags commander)"
  open_window "$addr" "$claude_cmd" "commander"
}

defined_operators() {
  local dir name
  for dir in "$LEGION_OPERATORS"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    [ "$name" = "commander" ] && continue
    valid_operator "$name" && echo "$name"
  done
}

# `legion deploy` with no operator: start commander and every defined
# operator with no mission. Each checks in with who it is and what it does,
# and commander prints the roll call once everyone has answered.
cmd_rollcall() {
  local ops
  ops="$(defined_operators)"
  [ -n "$ops" ] || { echo "no operators defined yet — add a folder per operator under .legion/operators/, or: legion deploy <operator> [mission...]" >&2; exit 1; }
  local list
  list="$(echo "$ops" | paste -sd, - | sed 's/,/, /g')"
  LEGION_KICKOFF="Roll call. No mission yet. You're expecting check-ins from: $list. As each CHECK-IN arrives, update the roster as usual. Once all of them have checked in (or after a few minutes, noting who didn't), print a short roll call here: each operator's name and, in a line, who they are and what they do. Then wait for a mission from the human." \
    cmd_commander
  local op
  for op in $ops; do
    LEGION_KICKOFF="wait for a mission — this is a roll call, there is no work yet." \
      cmd_deploy "$op"
  done
  echo "roll call started: commander + $list"
  cmd_grid
}

cmd_deploy() {
  require_active
  if [ $# -eq 0 ]; then cmd_rollcall; return; fi
  local operator="${1:-}"
  valid_operator "$operator" || { echo "usage: legion deploy <operator> [mission...] (operator must be a plain name, not a flag)" >&2; exit 1; }
  shift
  local mission="$*"
  local mission_display="${mission:-none yet — wait for instructions}"
  local addr="$LEGION_SQUAD_NAME-$operator"
  local base max
  base="$(operator_base "$operator")"
  if [ "$base" != "$operator" ]; then
    max="$(scale_max "$base")" || exit 1
    [ "${operator##*-}" -ge 2 ] && [ "${operator##*-}" -le "$max" ] \
      || { echo "legion: $base can run at most $max copies ($base, $base-2 … $base-$max)" >&2; exit 1; }
  fi
  local commander_addr="$LEGION_SQUAD_NAME-commander"
  # An operator checks in with commander and reports to it, so one always
  # has to exist before the other starts — bare `legion deploy` (roll call)
  # already guaranteed this, `legion deploy <operator>` didn't, and an
  # operator started without a commander just leaves its check-in and
  # report_done messages sitting unread forever (verified: exactly this
  # happened). cmd_scale's "up" case deploys through here too, so it's
  # covered the same way.
  #
  # A commander started for a deploy gets a kickoff naming the operator it's
  # waiting on, rather than cmd_commander's generic "no mission yet" one, so
  # it knows a check-in is coming.
  if [ -z "$(pane_of "$commander_addr")" ]; then
    LEGION_KICKOFF="You were just started because '$operator' is being deployed. Wait for its check-in (start 'legion message wait' in the background) and go from there." \
      cmd_commander
  fi
  local prompt
  prompt="You are '$addr' on a small squad commanded by '$commander_addr', run on mission command: commander sets direction and goals, you own the how. Message commander to check in, to report your mission done, to ask for mission-level perspective, or to raise anything that needs a tiebreaker — a decision or disagreement only commander should settle. For your own domain, decide your approach yourself; commander gave you the what, not the method. When you need another operator's specific expertise, message them directly — this is normal, not an exception, and commander does not need to broker it. Run 'legion list' to see who is running, and read \$LEGION_OPERATORS/<their-operator-name>/definition.md if you want to know what they're good at before reaching out. Before doing anything else, check in: run legion message send commander \"CHECK-IN: operator=$operator role=<one or two sentences, in your own words, on who you are and what you do on this squad — from your operator definition if you have one> mission=$mission_display\", then start 'legion message wait' in the background. Check in every time you are started, including when this conversation is resumed: commander may be a brand-new session that has never heard from you, so an earlier check-in in this conversation does not count — send a fresh one. Messages are kept until they're read, so check in even if commander isn't running yet. Check in once per start, not repeatedly. Talking to the squad: send every message to another position on this squad with 'legion message send <position> \"<text>\"' (a position is commander, planner, builder-2 and so on), not SendMessage. Claude Code drops a SendMessage whose chain of replies loops back through a session, and a busy squad hits that quickly. Messages to you arrive the same way, so keep 'legion message wait' running in the background the whole time you're on the squad. Start it with the Bash tool's run_in_background option, never with a trailing & (Claude Code stops a command with & for approval, and you'd sit there deaf). When it finishes, your new messages are shown to you automatically (if they aren't, run 'legion message read'): act on them, then start the wait again straight away. Only use SendMessage to reply to a session outside the squad, such as the human's own Claude session. Your mission: $mission_display

If your mission file has a 'Handoff' section, you (or an earlier copy of you) wrote it before a clear or at the end of a day: carry on from the latest one. If your mission file has a 'worktree:' header, that folder is where this mission's code lives: read, edit, test and commit there (use its paths for file edits, and cd into it for shell commands). Don't touch the project root's copy of those files for this mission. Mission files, the roster and the log stay in the project root's .legion/ — update those there, never in the worktree.

If the mission file you were given has a 'pipeline: <name>' header, read that pipeline to find your step in it. Pipelines are Markdown files, $LEGION_PIPELINES/<name>.md, holding a Mermaid flowchart. Each box is a step, named after the operator who does it (builder[builder: build it]); the first box is the first step. A diamond is a statement that is either true or false (approved{the change is approved}), decided by whoever just finished, and its arrows are labelled yes or no. A labelled arrow out of a step is only followed when its label is true; an unlabelled arrow is the normal next step. A rounded box named done ends the pipeline. $LEGION_PIPELINES/README.md has the full rules. An older squad may still have a plain list at $LEGION_PIPELINES/<name> instead: one operator per line, in order, with # lines as comments. When you finish your step, decide any question that follows it and follow the arrows to the next step. If that step belongs to another operator, hand off through commander: add a short note of what you did to the mission file (the mission_note tool), then call the legion MCP tool handoff with the mission and the next operator. Commander starts or messages the next operator, picks a free copy if it's scalable, and moves the mission along. You never start, scale up or stand down another position yourself; only commander does. If the arrows lead to done, or the mission has no pipeline field, report back to '$commander_addr' with the report_done tool when your mission is done. If you need a decision only the human can make, use the ask_human tool (numbered options, a short example for each, and a recommendation), never an on-screen question box, then wait for the answer to arrive as a message — and along the way, reach out to any other operator directly whenever their expertise would help."
  [ -s "$LEGION_DOCTRINE" ] && prompt="$prompt

This squad's doctrine:
$(cat "$LEGION_DOCTRINE")"
  [ -s "$(operator_dir "$operator")/definition.md" ] && prompt="$prompt

Your operator definition:
$(cat "$(operator_dir "$operator")/definition.md")"
  check_operator "$(operator_base "$operator")" || exit 1
  config_mode "$operator" >/dev/null || exit 1
  local claude_cmd="$(prompt_flag "$operator" "$prompt")"
  # Always send an opening message, even on a resume with no mission: without
  # one a resumed session just sits there, and it must check in every start.
  local kickoff="You have just been started (or restarted). Check in with commander now, as your instructions describe — every start, even if this conversation already shows an earlier check-in."
  if [ -n "$mission" ]; then
    kickoff="$kickoff Then get started: $mission"
  else
    kickoff="$kickoff Then ${LEGION_KICKOFF:-wait for a mission.}"
  fi
  claude_cmd="$claude_cmd $(printf '%q' "$kickoff")"
  claude_cmd="$claude_cmd$(claude_flags "$operator")"
  open_window "$addr" "$claude_cmd" "$operator"
}

cmd_squad() {
  require_active
  local mission="${*:-no overall mission specified yet}"
  cmd_commander "$mission"
  cmd_deploy planner "Break the overall mission into a concrete plan for commander to hand out. Overall mission: $mission"
  cmd_deploy builder "Implement whatever commander assigns you from the plan. Ask planner or reviewer directly if you need their input."
  cmd_deploy reviewer "Review whatever commander sends you and report issues back to commander. Message builder directly if you need to clarify something with them."
  cmd_grid
}

cmd_roster() {
  require_active
  local f found=0
  for f in "$LEGION_ROSTER"/*.md; do
    [ -e "$f" ] || continue
    found=1
    echo "== $(basename "$f" .md) =="
    cat "$f"
    echo
  done
  [ "$found" -eq 1 ] || echo "(no operators checked in yet)"
}

cmd_attach() {
  require_active
  valid_operator "${1:-}" || { echo "usage: legion attach <operator>" >&2; exit 1; }
  local name="$LEGION_SQUAD_NAME-$1" pane session
  pane="$(pane_of "$name")"
  [ -n "$pane" ] || { echo "'$name' is not running" >&2; exit 1; }
  # Session name, not the pane id, for switch/attach — see cmd_grid.
  session="$(tmux display-message -t "$pane" -p '#{session_name}')"
  tmux select-window -t "$pane" \; select-pane -t "$pane"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

cmd_capture() {
  require_active
  valid_operator "${1:-}" || { echo "usage: legion capture <operator> [lines]" >&2; exit 1; }
  local name="$LEGION_SQUAD_NAME-$1" pane
  pane="$(pane_of "$name")"
  [ -n "$pane" ] || { echo "'$name' is not running" >&2; exit 1; }
  if [ -n "${2:-}" ]; then
    tmux capture-pane -t "$pane" -p -S "-$2"
  else
    tmux capture-pane -t "$pane" -p
  fi
}

# A position that's handing off and clearing (see context_stop) gets up to
# a minute to finish first. Stopping it halfway would keep the old, full
# conversation as the one to reopen.
wait_for_clear() {
  local dir n=0
  dir="$(context_dir)"
  while { [ -f "$dir/$1.refresh" ] || [ -f "$dir/$1.clearing" ]; } && [ "$n" -lt 60 ]; do
    sleep 1
    n=$((n + 1))
  done
  return 0
}

cmd_standdown() {
  require_active
  if [ $# -eq 0 ]; then cmd_standdown_all; return; fi
  valid_operator "${1:-}" || { echo "usage: legion stand-down [operator]" >&2; exit 1; }
  local name="$LEGION_SQUAD_NAME-$1" pane window
  pane="$(pane_of "$name")"
  [ -n "$pane" ] || { echo "'$name' not found" >&2; exit 1; }
  window="$(squad_window)"
  wait_for_clear "$1"
  session_log "$1: stood down"
  tmux kill-pane -t "$pane"
  [ -n "$window" ] && tmux select-layout -t "$window" tiled 2>/dev/null
  return 0
}

# Stops operators before commander, so commander isn't left running while
# they disappear. Each keeps its saved conversation, so the next
# `legion deploy` picks up where it left off.
cmd_standdown_all() {
  local rows addr pane stopped=""
  rows="$(squad_panes)"
  [ -n "$rows" ] || { echo "no panes running for squad '$LEGION_SQUAD_NAME'"; return 0; }
  while IFS="$(printf '\t')" read -r addr pane _; do
    [ "$addr" = "$LEGION_SQUAD_NAME-commander" ] && continue
    wait_for_clear "${addr#"$LEGION_SQUAD_NAME"-}"
    session_log "${addr#"$LEGION_SQUAD_NAME"-}: stood down"
    tmux kill-pane -t "$pane" && stopped="$stopped ${addr#"$LEGION_SQUAD_NAME"-}"
  done <<EOF
$rows
EOF
  pane="$(pane_of "$LEGION_SQUAD_NAME-commander")"
  [ -n "$pane" ] && session_log "commander: stood down" && tmux kill-pane -t "$pane" && stopped="$stopped commander"
  echo "stood down:$stopped"
}

# Finds a mission file by number (5, 0005) or full name, active/ first.
mission_file() {
  local id="$1" n f
  case "$id" in
    *[!0-9]*) n="$id" ;;
    *) n="$(printf '%04d' "$((10#$id))")" ;;
  esac
  for f in "$LEGION_MISSIONS/active/$n"*.md "$LEGION_MISSIONS/todo/$n"*.md "$LEGION_MISSIONS/done/$n"*.md; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

# Sets "key: value" in a mission file's header (the lines before the first
# blank line), replacing the key if it's already there.
set_header() {
  local file="$1" key="$2" value="$3" tmp
  tmp="$(mktemp)"
  awk -v k="$key" -v v="$value" '
    !done && index($0, k ": ") == 1 { print k ": " v; done = 1; next }
    !done && $0 == "" { print k ": " v; done = 1 }
    { print }
    END { if (!done) print k ": " v }
  ' "$file" > "$tmp" && cat "$tmp" > "$file"
  rm -f "$tmp"
}

# The next unused mission number across all three folders, so create never
# reuses one even if the highest-numbered mission has already moved to
# done/ or been renamed.
next_mission_number() {
  local top=0 f base n
  for f in "$LEGION_MISSIONS"/todo/*.md "$LEGION_MISSIONS"/active/*.md "$LEGION_MISSIONS"/done/*.md; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in
      [0-9][0-9][0-9][0-9]-*)
        n="$((10#${base%%-*}))"
        [ "$n" -gt "$top" ] && top="$n"
        ;;
    esac
  done
  echo $((top + 1))
}

# A pipeline can be a Mermaid file (current) or, on an older squad, a plain
# list with no extension (see the Pipelines section of the README) — a
# mission's pipeline: header has to resolve to one or the other, or an
# operator hits a dead end trying to read it partway through a mission,
# far past where a typo would have been easy to catch.
pipeline_exists() {
  [ -f "$LEGION_PIPELINES/$1.md" ] || [ -f "$LEGION_PIPELINES/$1" ]
}

cmd_mission_create() {
  local slug="${1:-}"; [ -n "$slug" ] && shift
  local pipeline="" desc=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --pipeline) pipeline="${2:-}"; shift 2 ;;
      *) desc+=("$1"); shift ;;
    esac
  done
  [ -n "$slug" ] && [ "${#desc[@]}" -gt 0 ] \
    || { echo "usage: legion mission create <slug> <description...> [--pipeline <name>]" >&2; exit 1; }
  if [ -n "$pipeline" ]; then
    pipeline_exists "$pipeline" || {
      echo "legion: no pipeline called '$pipeline' — looked for $LEGION_PIPELINES/$pipeline.md" >&2
      local available="" f base
      for f in "$LEGION_PIPELINES"/*.md; do
        [ -f "$f" ] || continue
        base="$(basename "$f" .md)"
        [ "$base" = "README" ] && continue
        available="$available $base"
      done
      [ -n "$available" ] && echo "available pipelines:$available" >&2
      exit 1
    }
  fi
  local n slug_clean name path
  n="$(next_mission_number)"
  slug_clean="$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')"
  [ -n "$slug_clean" ] || slug_clean="mission"
  name="$(printf '%04d-%s' "$n" "$slug_clean")"
  mkdir -p "$LEGION_MISSIONS/todo"
  path="$LEGION_MISSIONS/todo/$name.md"
  {
    printf 'created: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    [ -n "$pipeline" ] && printf 'pipeline: %s\n' "$pipeline"
    printf '\n%s\n' "${desc[*]}"
  } > "$path"
  echo "created $path$([ -n "$pipeline" ] && echo " (pipeline: $pipeline)")"
}

# Each mission that changes code gets its own git worktree under
# .legion/worktrees/, on branch mission/<name>, so a paused or parallel
# mission can't leave edits in another's way. finish only fast-forwards: if
# the base branch has moved on, the mission branch has to be rebased first,
# which keeps history linear and never merges on anyone's behalf.
cmd_mission() {
  require_active
  local sub="${1:-}"
  if [ "$sub" = "create" ]; then
    shift
    cmd_mission_create "$@"
    return
  fi
  local id="${2:-}"
  case "$sub" in
    start|finish) [ -n "$id" ] || { echo "usage: legion mission $sub <number>" >&2; exit 1; } ;;
    *) echo "usage: legion mission create <slug> <description...> [--pipeline <name>] | legion mission start|finish <number>" >&2; exit 1 ;;
  esac
  local root file slug branch path base current
  root="$(dirname "$LEGION_ROOT")"
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 \
    || { echo "legion: $root isn't a git repo — mission worktrees need one" >&2; exit 1; }
  file="$(mission_file "$id")" || { echo "no mission file matching '$id'" >&2; exit 1; }
  slug="$(basename "$file" .md)"
  branch="mission/$slug"
  path="$LEGION_ROOT/worktrees/$slug"
  current="$(git -C "$root" rev-parse --abbrev-ref HEAD)"
  case "$sub" in
    start)
      if [ -d "$path" ]; then echo "$path"; return 0; fi
      awk '$0 == "worktrees" { f = 1 } END { exit !f }' "$LEGION_ROOT/.gitignore" 2>/dev/null \
        || echo "worktrees" >> "$LEGION_ROOT/.gitignore"
      git -C "$root" worktree add -q -b "$branch" "$path" "$current" || exit 1
      set_header "$file" worktree "$path"
      set_header "$file" branch "$branch"
      set_header "$file" base "$current"
      echo "$path"
      ;;
    finish)
      [ -d "$path" ] || { echo "no worktree for $slug" >&2; exit 1; }
      [ -z "$(git -C "$path" status --porcelain)" ] \
        || { echo "$path has uncommitted changes — commit or discard them first" >&2; exit 1; }
      base="$(awk -F': ' '$0 == "" { exit } $1 == "base" { print $2; exit }' "$file")"
      base="${base:-$current}"
      [ "$current" = "$base" ] \
        || { echo "the project root is on '$current', not '$base' — switch it back first" >&2; exit 1; }
      git -C "$root" -c advice.diverging=false merge --ff-only -q "$branch" 2>/dev/null \
        || { echo "can't fast-forward $base to $branch — rebase first: cd $path && git rebase $base" >&2; exit 1; }
      git -C "$root" worktree remove "$path" && git -C "$root" branch -q -d "$branch"
      set_header "$file" worktree "(merged into $base and removed)"
      echo "merged $branch into $base"
      ;;
  esac
}

cmd_scale() {
  require_active
  local sub="${1:-}" op max n running addr
  case "$sub" in
    up) op="${2:-}"; shift 2 2>/dev/null || true ;;
    *) op="$sub"; sub="status" ;;
  esac
  valid_operator "$op" || { echo "usage: legion scale <operator> | legion scale up <operator> [mission...]" >&2; exit 1; }
  max="$(scale_max "$op")" || { echo "legion: $op isn't scalable — add a 'scale' file to .legion/operators/$op/ (blank means up to 5)" >&2; exit 1; }
  running="$(squad_panes | awk -F '\t' -v p="$LEGION_SQUAD_NAME-$op" '$1 == p || (index($1, p "-") == 1 && substr($1, length(p) + 2) ~ /^[0-9]+$/) { print $1 }')"
  if [ "$sub" = "status" ]; then
    echo "$op: $(printf '%s\n' "$running" | awk NF | wc -l | xargs) of $max running"
    printf '%s\n' "$running" | awk NF | sed 's/^/  /'
    return 0
  fi
  n=1
  while [ "$n" -le "$max" ]; do
    [ "$n" -eq 1 ] && addr="$op" || addr="$op-$n"
    if ! printf '%s\n' "$running" | awk -v a="$LEGION_SQUAD_NAME-$addr" '$0 == a { f = 1 } END { exit !f }'; then
      cmd_deploy "$addr" "$@"
      return
    fi
    n=$((n + 1))
  done
  echo "legion: all $max copies of $op are already running" >&2
  exit 1
}

# Messages between squad positions go through files, not Claude Code's
# SendMessage: Claude Code drops a SendMessage whose chain of replies loops
# back through a session, and orders-and-results traffic hits that fast. A
# session waits with a background `legion message wait`; Claude Code wakes it
# when that command finishes, which isn't a message between sessions, so
# there's no chain to cut. Each message is a file in
# .legion/messages/<position>/new/, moved to read/ once printed.
message_dir() {
  echo "$LEGION_ROOT/messages/$1"
}

# The position running this command: LEGION_POSITION, set when legion starts
# a session, unless --as says otherwise. Anyone else is "human".
message_me() {
  echo "${LEGION_MESSAGE_AS:-${LEGION_POSITION:-human}}"
}

message_print() {
  local f="$1"
  awk 'NR == 1 { sub(/^from: /, ""); from = $0; next }
       NR == 3 { sub(/^sent: /, ""); printf "--- from %s at %s\n", from, $0; next }
       NR <= 4 { next }
       { print }' "$f"
}

# Unread messages for a position, oldest first, one file name per line.
message_unread() {
  local dir
  dir="$(message_dir "$1")/new"
  [ -d "$dir" ] && ls -tr "$dir" 2>/dev/null
  return 0
}

# Prints every unread message for a position, oldest first, and marks them read.
message_take() {
  local me="$1" dir f found=1
  dir="$(message_dir "$me")"
  [ -d "$dir/new" ] || return 1
  mkdir -p "$dir/read"
  for f in $(ls -tr "$dir/new" 2>/dev/null); do
    message_print "$dir/new/$f"
    echo
    mv "$dir/new/$f" "$dir/read/$f"
    found=0
  done
  return "$found"
}

cmd_message() {
  require_active
  local sub="${1:-}" me to text dir tmp name timeout="" waited=0
  [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) LEGION_MESSAGE_AS="${2:-}"; shift 2 ;;
      --timeout) timeout="${2:-}"; shift 2 ;;
      *) break ;;
    esac
  done
  me="$(message_me)"
  me="${me#"$LEGION_SQUAD_NAME"-}"
  awk '$0 == "messages" { f = 1 } END { exit !f }' "$LEGION_ROOT/.gitignore" 2>/dev/null \
    || echo "messages" >> "$LEGION_ROOT/.gitignore"
  case "$sub" in
    send)
      to="${1:-}"
      # Accept a full session address (squad-builder) as well as the position.
      to="${to#"$LEGION_SQUAD_NAME"-}"
      valid_operator "$to" || { echo "usage: legion message send <position> <text...>   (use - to read the text from stdin)" >&2; exit 1; }
      shift
      if [ "${1:-}" = "-" ]; then text="$(cat)"; else text="$*"; fi
      [ -n "$text" ] || { echo "legion: nothing to send" >&2; exit 1; }
      dir="$(message_dir "$to")"
      mkdir -p "$dir/new" "$dir/tmp"
      name="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM-$me.md"
      tmp="$dir/tmp/$name"
      printf 'from: %s\nto: %s\nsent: %s\n\n%s\n' "$me" "$to" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$text" > "$tmp"
      # Written elsewhere first, then moved in, so a waiting reader never sees half a message.
      mv "$tmp" "$dir/new/$name"
      echo "sent to $to"
      if [ "$to" != "commander" ] && [ "$to" != "human" ] && [ ! -d "$LEGION_OPERATORS/$(operator_base "$to")" ] \
         && [ -z "$(pane_of "$LEGION_SQUAD_NAME-$to")" ]; then
        echo "note: no operator called '$to' is defined or running, so nobody may read this" >&2
      fi
      ;;
    wait)
      # Only announces new mail; the message hooks hand it over and mark it
      # read, so a message counts as read once it has actually been shown.
      dir="$(message_dir "$me")"
      mkdir -p "$dir/new"
      echo $$ > "$dir/waiting.pid"
      local seen="$dir/announced" fresh
      touch "$seen"
      while :; do
        fresh="$(message_unread "$me" | grep -vxF -f "$seen" || true)"
        [ -n "$fresh" ] && break
        if [ -n "$timeout" ] && [ "$waited" -ge "$timeout" ]; then
          rm -f "$dir/waiting.pid"
          echo "no messages for $me after ${timeout}s"
          exit 1
        fi
        sleep 1
        waited=$((waited + 1))
      done
      printf '%s\n' "$fresh" >> "$seen"
      rm -f "$dir/waiting.pid"
      echo "$(printf '%s\n' "$fresh" | awk NF | wc -l | xargs) new message(s) for $me. They're shown to you automatically; if not, run: legion message read"
      echo "(start 'legion message wait' in the background again to keep listening)"
      ;;
    hook)
      # Called by Claude Code hooks legion adds to every session (see
      # claude_flags). Reads the hook's JSON on stdin.
      local event="${1:-}" input text active
      input="$(cat)"
      dir="$(message_dir "$me")"
      if [ "$event" = "bash" ]; then
        # A shell & sends the wait past Claude Code's approval checks, so it
        # stops to ask a person and the session sits deaf. Turn the command
        # back with the right way to start it.
        if printf '%s' "$input" | jq -r '.tool_input.command // ""' \
           | grep -Eq 'legion message wait[^;|]*&[[:space:]]*$|nohup[[:space:]].*legion message wait'; then
          jq -n '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny",
            permissionDecisionReason: "Run `legion message wait` without & and set the Bash tool run_in_background option to true instead."}}'
        fi
        return 0
      fi
      # The session is working again, so it's no longer stuck on a usage
      # limit (see watch_run).
      rm -f "$(context_dir)/$me.limited"
      if [ -n "$(message_unread "$me")" ]; then
        text="$(message_take "$me")"
        if [ "$event" = "stop" ]; then
          jq -n --arg t "New messages for you on the squad — act on them:

$text" '{decision: "block", reason: $t}'
        else
          jq -n --arg t "New messages for you on the squad:

$text" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $t}}'
        fi
        return 0
      fi
      [ "$event" = "stop" ] || return 0
      # stop_hook_active means this stop already came from a hook block, so
      # let it through rather than loop.
      active="$(printf '%s' "$input" | jq -r '.stop_hook_active // false' 2>/dev/null)"
      wrap_up_stop "$me"
      # A full conversation hands off and clears (see context_stop). It's
      # about to be cleared, so it doesn't need a message wait first.
      context_stop "$me" "$active" && return 0
      # Don't let the session go idle deaf: it must be waiting for messages.
      if [ "$active" != "true" ] && ! { [ -f "$dir/waiting.pid" ] && kill -0 "$(cat "$dir/waiting.pid")" 2>/dev/null; }; then
        jq -n '{decision: "block", reason: "Before you stop: start `legion message wait` with the run_in_background option of the Bash tool (not a trailing &) so you hear new messages from the squad."}'
      fi
      return 0
      ;;
    read)
      message_take "$me" || echo "no new messages for $me"
      ;;
    log)
      local who="${1:-$me}" f
      dir="$(message_dir "$who")"
      [ -d "$dir" ] || { echo "no messages for $who"; return 0; }
      for f in $( (ls "$dir/read" 2>/dev/null; ls "$dir/new" 2>/dev/null) | sort); do
        [ -f "$dir/read/$f" ] && message_print "$dir/read/$f" || { message_print "$dir/new/$f"; echo "(unread)"; }
        echo
      done
      ;;
    *)
      echo "usage: legion message send <position> <text...> | wait [--timeout <seconds>] | read | log [position]   (--as <position> to act as someone else)" >&2
      exit 1
      ;;
  esac
}

channel_dir() {
  echo "$LEGION_ROOT/channel"
}

# One background legion-channeld per squad, independent of any Claude
# session — it has to keep relaying (and answering `legion channel peers`)
# even while the whole squad is stood down. See legion-channeld's own
# docstring for what it actually does; everything here just starts, feeds
# and stops it via plain files in .legion/channel/.
channel_daemon_running() {
  local dir; dir="$(channel_dir)"
  [ -f "$dir/channel.pid" ] && kill -0 "$(cat "$dir/channel.pid")" 2>/dev/null
}

channel_start_daemon() {
  local dir script; dir="$(channel_dir)"; mkdir -p "$dir"
  script="$(cd "$(dirname "$0")" && pwd)/legion-channeld"
  nohup python3 "$script" --root "$LEGION_ROOT" >> "$dir/channel.log" 2>&1 &
  disown
  echo $! > "$dir/channel.pid"
  sleep 0.3
  channel_daemon_running || { echo "legion: channel daemon failed to start — see $dir/channel.log" >&2; exit 1; }
}

channel_ensure_daemon() {
  channel_daemon_running || channel_start_daemon
}

channel_stop_daemon() {
  local dir; dir="$(channel_dir)"
  if [ -f "$dir/channel.pid" ]; then
    kill "$(cat "$dir/channel.pid")" 2>/dev/null || true
    rm -f "$dir/channel.pid"
  fi
}

cmd_channel() {
  require_active
  local dir; dir="$(channel_dir)"
  mkdir -p "$dir" "$dir/peers" "$dir/outbox"
  awk '$0 == "channel" { f = 1 } END { exit !f }' "$LEGION_ROOT/.gitignore" 2>/dev/null \
    || echo "channel" >> "$LEGION_ROOT/.gitignore"
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  case "$sub" in
    open)
      local port="" key=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --port) port="${2:-}"; shift 2 ;;
          --key) key="${2:-}"; shift 2 ;;
          *) echo "usage: legion channel open [--port <n>] [--key <key>]" >&2; exit 1 ;;
        esac
      done
      [ -n "$port" ] || { echo "usage: legion channel open --port <n> [--key <key>]" >&2; exit 1; }
      jq -n --arg port "$port" --arg key "$key" \
        '{port: ($port | tonumber), key: (if $key == "" then null else $key end)}' > "$dir/config.json"
      channel_stop_daemon
      channel_start_daemon
      echo "channel open on port $port$([ -n "$key" ] && echo " (key required)")"
      ;;
    subscribe)
      local hostport="${1:-}" team="" key=""
      [ -n "$hostport" ] && shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --team) team="${2:-}"; shift 2 ;;
          --key) key="${2:-}"; shift 2 ;;
          *) echo "usage: legion channel subscribe <host:port> --team <name> [--key <key>]" >&2; exit 1 ;;
        esac
      done
      [ -n "$hostport" ] && [ -n "$team" ] \
        || { echo "usage: legion channel subscribe <host:port> --team <name> [--key <key>]" >&2; exit 1; }
      local host="${hostport%:*}" port="${hostport##*:}"
      [ -n "$host" ] && [ "$port" != "$hostport" ] \
        || { echo "usage: legion channel subscribe <host:port> --team <name> [--key <key>]" >&2; exit 1; }
      [ -f "$dir/subscriptions.json" ] || echo "[]" > "$dir/subscriptions.json"
      local tmp; tmp="$(mktemp)"
      jq --arg h "$host" --arg p "$port" --arg t "$team" --arg k "$key" \
        '[.[] | select(.team != $t)] + [{host: $h, port: ($p | tonumber), team: $t, key: (if $k == "" then null else $k end)}]' \
        "$dir/subscriptions.json" > "$tmp"
      mv "$tmp" "$dir/subscriptions.json"
      channel_ensure_daemon
      echo "subscribing to $team at $hostport"
      ;;
    send)
      local team="${1:-}"; [ -n "$team" ] && shift
      local operator=""
      while [ "${1:-}" = "--operator" ]; do operator="${2:-}"; shift 2; done
      [ -n "$team" ] && [ $# -gt 0 ] \
        || { echo "usage: legion channel send <team> [--operator <name>] <text...>" >&2; exit 1; }
      local text="$*"
      jq -n --arg to "$team" --arg op "$operator" --arg text "$text" \
        '{to: $to, text: $text} + (if $op == "" then {} else {operator: $op} end)' \
        > "$dir/outbox/$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM.json"
      echo "queued for $team$([ -n "$operator" ] && echo " ($operator)")"
      if [ ! -f "$dir/peers/$(printf '%s' "$team" | tr -c 'a-zA-Z0-9_-' '_').json" ] \
         || [ "$(jq -r '.connected // false' "$dir/peers/$(printf '%s' "$team" | tr -c 'a-zA-Z0-9_-' '_').json" 2>/dev/null)" != "true" ]; then
        echo "note: $team isn't connected right now. The channel keeps trying for 10 minutes, then keeps it in .legion/channel/outbox/failed/. 'legion channel peers' shows who's reachable." >&2
      fi
      ;;
    peers)
      local f found=0
      for f in "$dir/peers"/*.json; do
        [ -e "$f" ] || continue
        found=1
        jq -r '"\(.team)  connected=\(.connected // false)\(if .via then "  via=\(.via)" else "" end)  operators=\([.operators[]?.name] | join(","))"' "$f"
      done
      [ "$found" -eq 1 ] || echo "(no peers known yet)"
      ;;
    close)
      channel_stop_daemon
      rm -f "$dir/config.json"
      echo "channel closed"
      ;;
    *)
      echo "usage: legion channel open|subscribe|send|peers|close ..." >&2
      exit 1
      ;;
  esac
}

# One shared, append-only log for the whole squad: every tool call any
# position makes, regardless of operator or session restarts. Machine-local
# (out of git) since it's pure activity, not a decision or a record worth
# keeping in history the way log.md is.
activity_log() {
  echo "$LEGION_ROOT/activity.log"
}

# Handing off and clearing a full conversation. Once a session holding a
# mission is clearAt percent full, its Stop hook asks it to write a handoff
# note and run `legion refresh`. The next time it stops, Legion types /clear
# into its pane and restarts it from the note. A handoff the session writes
# itself keeps what matters; Claude Code's own summary is a guess at that.
# Files, all under $LEGION_LOCAL/context/:
#   <position>           how full the conversation is, in percent, written
#                        by the status line
#   <position>.refresh   `legion refresh` ran: clear at the next stop
#   <position>.clearing  a clear is under way (holds when it started)
context_dir() {
  echo "$LEGION_LOCAL/context"
}

# Clears anything half-typed in a Claude Code pane before Legion types into
# it. Ctrl-U deletes the line and Backspace joins the one above, so this
# clears several lines. Never Ctrl-C: Claude Code quits on a second Ctrl-C
# soon after a first, so two of Legion's own clears close together would
# end the session. On an empty prompt these keys do nothing.
pane_clear_input() {
  local i
  for i in 1 2 3 4; do
    tmux send-keys -t "$1" C-u
    tmux send-keys -t "$1" BSpace
  done
  tmux send-keys -t "$1" C-u
  sleep 0.5
}

# One line in .legion/local/sessions.log: what Legion did to a session, and
# how each session ended (see cmd_pane_died).
session_log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LEGION_LOCAL/sessions.log" 2>/dev/null || true
}

# `legion pane-died <log> <pane>`: run by the squad window's pane-died hook
# (see open_window), which keeps an exited pane just long enough for this.
# Records how the session ended, with its last lines, then closes the pane.
cmd_pane_died() {
  local log="$1" pane="$2" addr status signal window
  addr="$(tmux display -p -t "$pane" '#{@legion_addr}' 2>/dev/null)"
  status="$(tmux display -p -t "$pane" '#{pane_dead_status}' 2>/dev/null)"
  signal="$(tmux display -p -t "$pane" '#{pane_dead_signal}' 2>/dev/null)"
  window="$(tmux display -p -t "$pane" '#{window_id}' 2>/dev/null)"
  {
    printf '%s %s: session ended (exit status %s%s). Its last lines:\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "${addr:-$pane}" "${status:-?}" "${signal:+, signal $signal}"
    tmux capture-pane -p -t "$pane" 2>/dev/null | grep -v '^Pane is dead' | awk NF | tail -n 12 | sed 's/^/    /'
  } >> "$log" 2>/dev/null
  tmux kill-pane -t "$pane" 2>/dev/null
  [ -n "$window" ] && tmux select-layout -t "$window" tiled 2>/dev/null
  return 0
}

# Called from the Stop hook. Prints a block decision, or starts a clear, and
# returns 0 if it handled this stop; returns 1 to let the other checks run.
context_stop() {
  local me="$1" active="$2" dir pct limit mission name started reason
  dir="$(context_dir)"
  if [ -f "$dir/$me.refresh" ]; then
    mv "$dir/$me.refresh" "$dir/$me.clearing" 2>/dev/null || return 0
    date +%s > "$dir/$me.clearing"
    context_schedule_clear "$me"
    return 0
  fi
  if [ -f "$dir/$me.clearing" ]; then
    # A clear that never finished (its pane went away, say) mustn't leave
    # the session unchecked for good.
    started="$(cat "$dir/$me.clearing" 2>/dev/null)"
    [ $(( $(date +%s) - ${started:-0} )) -lt 300 ] && return 0
    rm -f "$dir/$me.clearing"
  fi
  [ "$active" = "true" ] && return 1
  limit="$(clear_at "$me")"
  [ -n "$limit" ] || return 1
  pct="$(cat "$dir/$me" 2>/dev/null)"
  [ -n "$pct" ] && [ "$pct" -ge "$limit" ] 2>/dev/null || return 1
  # Without a mission there's nothing to hand off. It clears once it has
  # one again and goes over.
  mission="$(position_mission "$me")"
  [ -n "$mission" ] || return 1
  if [ "$me" = "commander" ]; then
    reason="Your conversation is ${pct}% full; this squad clears it at ${limit}%. Before you stop, add a '## Handoff' section to the end of $LEGION_LOG: the missions in flight and who has them, what you're waiting on, open questions for the human, and anything else you'd hate to lose. Then run 'legion refresh' and end your turn. Legion will clear this conversation and start you again from that note."
  else
    name="$(basename "$mission" .md)"
    reason="Your conversation is ${pct}% full; this squad clears it at ${limit}%. Before you stop, add a handoff note to mission $name with the mission_note tool, heading 'Handoff': what's done, what's next, the files and decisions that matter, and anything else you'd hate to lose. Then run 'legion refresh' and end your turn. Legion will clear this conversation and start you again from that note."
  fi
  jq -n --arg r "$reason" '{decision: "block", reason: $r}'
  return 0
}

# Runs `legion context clear` from the tmux server, not from the hook: the
# hook has to return before the session can go idle and take the /clear,
# and a child of the hook could be stopped along with it.
context_schedule_clear() {
  run_detached "$1" context clear
}

# Runs `legion <args...>` as position $1 from the tmux server, in this
# squad, detached from whatever called it.
run_detached() {
  local me="$1" self args="" a
  shift
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  for a in "$@"; do args="$args $(printf '%q' "$a")"; done
  tmux run-shell -b "unset LEGION_ROOT; cd $(printf '%q' "$(dirname "$LEGION_ROOT")") && . .legion/bin/activate >/dev/null 2>&1 && LEGION_POSITION=$(printf '%q' "$me") $(printf '%q' "$self")$args >/dev/null 2>&1"
}

# Starting sessions again after a usage limit. When a turn fails on the
# limit, the StopFailure hook marks the session (<position>.limited in
# context_dir, holding when) and makes sure this watcher runs. A minute
# after the 5-hour limit resets, or 30 minutes after the mark if the reset
# time isn't known, it types a line into the session telling it to carry
# on. Any hook the session runs after that clears the mark, so a session
# that carried on by itself (Claude Code can do that too) is left alone,
# and one that hits the limit again is marked again. The watcher stops
# once nothing has been marked for 10 minutes.
watch_ensure() {
  local pidf="$LEGION_LOCAL/watch.pid"
  [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null && return 0
  run_detached human watch
}

cmd_watch() {
  require_active
  local pidf="$LEGION_LOCAL/watch.pid" dir f pos now since resets resume pane found idle_since=""
  if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then return 0; fi
  echo $$ > "$pidf"
  dir="$(context_dir)"
  while :; do
    now="$(date +%s)" found=0
    for f in "$dir"/*.limited; do
      [ -f "$f" ] || continue
      found=1
      pos="$(basename "$f" .limited)"
      since="$(cat "$f" 2>/dev/null)"
      since="${since:-$now}"
      resume=$((since + 1800))
      resets="$(jq -r '.five_hour.resets_at // 0 | floor' "$dir/rate-limits.json" 2>/dev/null)" || resets=0
      if [ "${resets:-0}" -gt "$since" ] && [ $((resets + 60)) -lt "$resume" ]; then resume=$((resets + 60)); fi
      [ "$now" -ge "$resume" ] || continue
      pane="$(pane_of "$LEGION_SQUAD_NAME-$pos")"
      [ -n "$pane" ] || { rm -f "$f"; continue; }
      echo "$now" > "$f"
      pane_clear_input "$pane"
      tmux send-keys -t "$pane" -l "Your usage limit should have reset now. Carry on from where you stopped."
      tmux send-keys -t "$pane" Enter
      echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) told $pos to carry on after its usage limit" >> "$LEGION_LOCAL/watch.log"
      session_log "$pos: told to carry on after its usage limit"
    done
    if [ "$found" -eq 1 ]; then idle_since=""
    else
      idle_since="${idle_since:-$now}"
      [ $((now - idle_since)) -ge 600 ] && break
    fi
    sleep "${LEGION_WATCH_TICK:-60}"
  done
  rm -f "$pidf"
}

cmd_refresh() {
  require_active
  local me dir
  me="$(message_me)"
  [ "$me" != "human" ] || { echo "legion refresh is for a squad session: it clears that session's conversation" >&2; exit 1; }
  dir="$(context_dir)"
  mkdir -p "$dir"
  date +%s > "$dir/$me.refresh"
  # --stay: clear and leave the session idle, for wrapping up (cmd_wrap_up).
  if [ "${1:-}" = "--stay" ]; then
    touch "$dir/$me.stay"
    # Commander clears last in a wrap-up: the squad is wrapped up now.
    [ "$me" = "commander" ] && date -u +%Y-%m-%dT%H:%M:%SZ > "$LEGION_LOCAL/wrapped-up"
    echo "Legion will clear this conversation as soon as you end your turn and leave you idle. End your turn now."
  else
    rm -f "$dir/$me.stay"
    echo "Legion will clear this conversation as soon as you end your turn, then start you again from your handoff note. End your turn now."
  fi
}

# Called from the Stop hook. During a wrap-up, once commander's handoff is
# the last section of the log, written since the wrap-up began, its stop
# clears it as `legion refresh --stay` would. Commander doesn't have to
# remember to run that, and its Stop hook no longer holds it back to start a
# message wait (which left it running, never cleared).
wrap_up_stop() {
  local marker
  marker="$(context_dir)/wrapping-up"
  [ "$1" = "commander" ] && [ -f "$marker" ] && [ "$LEGION_LOG" -nt "$marker" ] || return 0
  awk '/^## / { last = $0 } END { exit !(last ~ /^## Handoff/) }' "$LEGION_LOG" 2>/dev/null || return 0
  rm -f "$marker"
  cmd_refresh --stay >/dev/null
}

# End of day: the commander has every operator stop at a good point, write
# a handoff note and clear without starting again, then does the same.
# The next start picks up from those notes (see cmd_commander).
cmd_wrap_up() {
  require_active
  [ -n "$(pane_of "$LEGION_SQUAD_NAME-commander")" ] || { echo "legion: commander isn't running, so there's no squad to wrap up" >&2; exit 1; }
  LEGION_MESSAGE_AS=human cmd_message send commander "WRAP-UP: the human is wrapping up for the day. Wrap up the squad as your instructions describe." >/dev/null
  mkdir -p "$(context_dir)"
  touch "$(context_dir)/wrapping-up"
  echo "asked commander to wrap up the squad; it tells you when everyone has handed off and it's safe to shut down"
}

cmd_context() {
  require_active
  local sub="${1:-}" me dir input pct cmd pane prev screen n same old_wait mission kick id
  [ $# -gt 0 ] && shift
  me="$(message_me)"
  dir="$(context_dir)"
  mkdir -p "$dir"
  case "$sub" in
    statusline)
      # Claude Code's status line command (see claude_flags). Must always
      # print something and never fail.
      input="$(cat)"
      pct="$(printf '%s' "$input" | jq -r '.context_window.used_percentage // empty | floor' 2>/dev/null)" || pct=""
      [ -n "$pct" ] && printf '%s\n' "$pct" > "$dir/$me" 2>/dev/null
      # The account's usage limits and when they reset, for the watcher
      # that starts sessions again after a limit (see watch_run).
      printf '%s' "$input" | jq -c '.rate_limits // empty' > "$dir/rate-limits.tmp" 2>/dev/null \
        && [ -s "$dir/rate-limits.tmp" ] && mv "$dir/rate-limits.tmp" "$dir/rate-limits.json"
      cmd="$(cat "$LEGION_LOCAL/generated/$(operator_base "$me")/statusline-command" 2>/dev/null)" || cmd=""
      if [ -n "$cmd" ]; then
        printf '%s' "$input" | bash -c "$cmd" 2>/dev/null || true
      else
        echo "context ${pct:-0}% full"
      fi
      exit 0
      ;;
    hook)
      input="$(cat)"
      if [ "${1:-}" = "limit" ]; then
        # StopFailure: a turn ended on an API error. Only a usage limit
        # means waiting and trying again; watch_run does that.
        [ "$(printf '%s' "$input" | jq -r '.error_type // empty' 2>/dev/null)" = "rate_limit" ] || exit 0
        date +%s > "$dir/$me.limited"
        watch_ensure
        exit 0
      fi
      # SessionStart after a /clear, whoever typed it. The conversation has
      # a new id now; keep it, or relaunching this position would bring
      # back the one that was cleared.
      id="$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)" || id=""
      [ -n "$id" ] && printf '%s\n' "$id" > "$LEGION_LOCAL/$me"
      rm -f "$dir/$me"
      if [ -f "$dir/$me.clearing" ]; then
        rm -f "$dir/$me.clearing"
      else
        jq -n --arg t "This conversation was just cleared. You are still '$LEGION_SQUAD_NAME-$me' on the squad: your role and rules are in $LEGION_LOCAL/prompts/$me.md if you no longer have them. Start 'legion message wait' in the background before anything else." \
          '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $t}}'
      fi
      exit 0
      ;;
    clear)
      # Run from the tmux server by context_schedule_clear.
      pane="$(pane_of "$LEGION_SQUAD_NAME-$me")"
      [ -n "$pane" ] || { rm -f "$dir/$me.clearing"; exit 0; }
      # Wait for the turn to end: the pane unchanged for 3 seconds.
      prev="" n=0 same=0
      while [ "$n" -lt 60 ]; do
        screen="$(tmux capture-pane -p -t "$pane" 2>/dev/null)" || { rm -f "$dir/$me.clearing"; exit 0; }
        if [ "$screen" = "$prev" ]; then same=$((same + 1)); [ "$same" -ge 3 ] && break; else same=0; fi
        prev="$screen"
        sleep 1
        n=$((n + 1))
      done
      old_wait="$(cat "$(message_dir "$me")/waiting.pid" 2>/dev/null)" || old_wait=""
      mission="$(position_mission "$me")"
      pane_clear_input "$pane"
      tmux send-keys -t "$pane" -l "/clear"
      tmux send-keys -t "$pane" Enter
      session_log "$me: cleared at $(cat "$dir/$me" 2>/dev/null || echo "?")% full$([ -f "$dir/$me.stay" ] && echo ", wrapping up")"
      # The SessionStart hook removes the .clearing file once it's done.
      n=0
      while [ -f "$dir/$me.clearing" ] && [ "$n" -lt 30 ]; do sleep 1; n=$((n + 1)); done
      [ -f "$dir/$me.clearing" ] && session_log "$me: the clear didn't confirm within 30 seconds"
      # Wrapping up: close the window. A cleared session left idle takes a
      # turn from anything that reaches it (the old message wait ending,
      # say), then reads the log and carries on with the work. The next
      # start picks up from the notes instead (see wrap_up_resume).
      if [ -f "$dir/$me.stay" ]; then
        rm -f "$dir/$me.stay" "$dir/$me.clearing"
        session_log "$me: closed its window after wrapping up"
        tmux kill-pane -t "$pane" 2>/dev/null
        window="$(squad_window)"
        [ -n "$window" ] && tmux select-layout -t "$window" tiled 2>/dev/null
        exit 0
      fi
      # The old message wait outlives /clear, but the new conversation
      # didn't start it and won't hear from it. Stop it; the kickoff below
      # starts a fresh one.
      if [ -n "$old_wait" ] && kill "$old_wait" 2>/dev/null; then
        [ "$(cat "$(message_dir "$me")/waiting.pid" 2>/dev/null)" = "$old_wait" ] && rm -f "$(message_dir "$me")/waiting.pid"
      fi
      sleep 1
      kick="You were just cleared to free up room. You are still '$LEGION_SQUAD_NAME-$me' on the squad: your role and rules are in $LEGION_LOCAL/prompts/$me.md if you no longer have them. Start 'legion message wait' in the background first."
      if [ "$me" = "commander" ]; then
        kick="$kick Then read the latest '## Handoff' section at the end of $LEGION_LOG, the missions in $LEGION_MISSIONS/active/ and the roster, and carry on from there."
      elif [ -n "$mission" ]; then
        kick="$kick Then read the latest 'Handoff' section of $mission and carry on from there."
      fi
      tmux send-keys -t "$pane" -l "$kick"
      tmux send-keys -t "$pane" Enter
      ;;
    *)
      echo "usage: legion context statusline|hook|clear   (run by Legion itself; use legion refresh)" >&2
      exit 1
      ;;
  esac
}

# Every squad running on this machine, from any shell: one line per squad,
# "<squad>\t<its .legion folder>", read from the tags open_window puts on
# each pane.
running_squads() {
  local squad root start sep
  # tmux gets tabs (3.4 escapes control characters in -F output), turned
  # into \037 here because read merges runs of tabs, which an empty field
  # makes.
  sep="$(printf '\037')"
  { tmux list-panes -a -F '#{@legion_squad}	#{@legion_root}	#{pane_start_command}' 2>/dev/null || true; } \
    | tr '\t' "$sep" \
    | while IFS="$sep" read -r squad root start; do
        [ -n "$squad" ] || continue
        # Panes started before @legion_root existed: take the folder from
        # the ". <.legion>/bin/activate" in the command that started them.
        [ -n "$root" ] || root="$(printf '%s' "$start" | sed -n 's|.*&& \. \(.*\)/bin/activate .*|\1|p' | sed 's/\\\(.\)/\1/g')"
        [ -n "$root" ] && printf '%s\t%s\n' "$squad" "$root"
      done | awk -F '\t' '!seen[$1]++'
}

# `legion activity tail --all`: every running squad's activity at once,
# each line labelled with its squad. Checks for newly started squads every
# few seconds.
activity_tail_all() {
  local n="$1" started="" squad root
  # Each squad's tail runs as its own job, in its own process group, so
  # stopping this stops those and nothing else.
  set -m
  trap 'trap - INT TERM EXIT; for j in $(jobs -p); do kill -- "-$j" 2>/dev/null; done; exit 0' INT TERM EXIT
  [ -n "$(running_squads)" ] || echo "no squads running yet; waiting for one to start"
  while :; do
    while IFS="$(printf '\t')" read -r squad root; do
      [ -n "$squad" ] || continue
      case " $started " in *" $squad "*) continue ;; esac
      started="$started $squad"
      touch "$root/activity.log" 2>/dev/null || true
      { tail -n "$n" -F "$root/activity.log" 2>/dev/null \
          | jq -r --unbuffered --arg s "$squad" '"\(.time)  \($s)-\(.position)\t\(.tool)\t\(.summary)"' 2>/dev/null; } &
    done <<EOF
$(running_squads)
EOF
    sleep 5
  done
}

cmd_activity() {
  # --all needs no activated shell: it watches every squad on the machine.
  if [ "${1:-}" = "tail" ]; then
    case " $* " in
      *" --all "*)
        local a n=20
        for a in "$@"; do case "$a" in *[!0-9]*|"") ;; *) n="$a" ;; esac; done
        activity_tail_all "$n"
        return
        ;;
    esac
  fi
  require_active
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  local log; log="$(activity_log)"
  case "$sub" in
    hook)
      # Called by legion's PostToolUse hook on every session (see
      # claude_flags). Must never fail or print anything: a broken tool
      # call here would be a broken tool call for the session using it.
      local input position tool summary line
      input="$(cat)"
      position="${LEGION_POSITION:-human}"
      tool="$(printf '%s' "$input" | jq -r '.tool_name // "?"' 2>/dev/null)" || tool="?"
      summary="$(printf '%s' "$input" | jq -r '
        .tool_input as $i
        | ($i.command // $i.pattern // $i.file_path // $i.path // $i.url // ($i | tostring))
        | tostring | .[0:200]
      ' 2>/dev/null)" || summary=""
      line="$(jq -nc --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg pos "$position" --arg tool "$tool" --arg sum "$summary" \
        '{time: $t, position: $pos, tool: $tool, summary: $sum}' 2>/dev/null)" || exit 0
      awk '$0 == "activity.log" { f = 1 } END { exit !f }' "$LEGION_ROOT/.gitignore" 2>/dev/null \
        || echo "activity.log" >> "$LEGION_ROOT/.gitignore"
      printf '%s\n' "$line" >> "$log" 2>/dev/null
      exit 0
      ;;
    tail)
      local n="${1:-20}"
      [ -f "$log" ] || { echo "no activity yet"; return 0; }
      tail -n "$n" -f "$log" | jq -r --unbuffered '"\(.time)  \(.position)\t\(.tool)\t\(.summary)"'
      ;;
    *)
      echo "usage: legion activity tail [n] [--all]" >&2
      exit 1
      ;;
  esac
}

cmd_list() {
  require_active
  tmux list-sessions >/dev/null 2>&1 || { echo "no tmux server running"; return 0; }
  local out
  out="$(squad_panes | awk -F '\t' '{ printf "%s  %s  (%s)\n", $1, $2, $3 }')"
  if [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    echo "no panes running for squad '$LEGION_SQUAD_NAME'"
  fi
}

cmd_grid() {
  require_active
  local window session
  window="$(squad_window)"
  [ -n "$window" ] || { echo "no panes running for squad '$LEGION_SQUAD_NAME'" >&2; exit 1; }
  # A session name, not the window id itself, for the actual
  # switch/attach — attaching by window id silently renders nothing in at
  # least one real terminal (verified: ttyd's, used by the tool that
  # records this project's own demo GIF), while a session name works.
  # select-window still lands on the right window either way, since a
  # squad's session only ever has the one.
  session="$(tmux display-message -t "$window" -p '#{session_name}')"
  tmux select-layout -t "$window" tiled \; select-window -t "$window"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session" 2>/dev/null || true
  else
    tmux attach-session -t "$session"
  fi
}

# Bash reads a script from its file as it runs, so an edit or reinstall
# while a long command (like `legion message wait`) is running would make it
# read from the middle of the new file when it finishes. Everything runs from
# inside main, and the last line calls it and exits, so bash has read the
# whole file before running anything and never goes back to it.
main() {
  case "${1:-}" in
    init) shift; cmd_init "$@" ;;
    demo) shift; cmd_demo "$@" ;;
    src) echo "$LEGION_SRC" ;;
    mcp) shift; exec python3 "$(cd "$(dirname "$0")" && pwd)/legion-mcp" "$@" ;;
    pane-died) shift; cmd_pane_died "$@" ;;
    dash) shift; exec python3 "$(cd "$(dirname "$0")" && pwd)/legion-dash" "$@" ;;
    session) shift; cmd_session "$@" ;;
    commander) shift; cmd_commander "$@" ;;
    deploy) shift; cmd_deploy "$@" ;;
    squad) shift; cmd_squad "$@" ;;
    roster) cmd_roster ;;
    attach) shift; cmd_attach "$@" ;;
    capture) shift; cmd_capture "$@" ;;
    stand-down) shift; cmd_standdown "$@" ;;
    list) cmd_list ;;
    message) shift; cmd_message "$@" ;;
    channel) shift; cmd_channel "$@" ;;
    activity) shift; cmd_activity "$@" ;;
    refresh) shift; cmd_refresh "$@" ;;
    watch) shift; cmd_watch "$@" ;;
    wrap-up) shift; cmd_wrap_up "$@" ;;
    context) shift; cmd_context "$@" ;;
    check) shift; cmd_check "$@" ;;
    scale) shift; cmd_scale "$@" ;;
    mission) shift; cmd_mission "$@" ;;
    grid) cmd_grid ;;
    *) usage ;;
  esac
}

main "$@"; exit

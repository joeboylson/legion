{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legion",
  "version": "0.1.0",
  "identifier": "com.joeboylson.legion2",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "npm run watch",
      "wait": false
    },
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Legion",
        "width": 1440,
        "height": 900,
        "minWidth": 987,
        "minHeight": 610
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
